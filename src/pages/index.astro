
---
import "../scripts/torneo.js";

const discordUrl = "https://discord.gg/3GWTVzjHS4";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Copa Artemis 2026: participa en el concurso Pokémon de Artemis x Curi Gameplays."
    />
    <meta name="theme-color" content="#080b14" />
    <title>Copa Artemis 2026 | Artemis x Curi Gameplays</title>
  </head>

  <body>
    <div id="toast-container" class="toast-container" hidden>
      <div id="toast-body" class="toast-body">
        <span id="toast-message">Mensaje</span>
      </div>
    </div>

    <header class="navbar">
      <a class="brand" href="#inicio" aria-label="Copa Artemis, inicio">
        <span class="brand-icon">A</span>
        <span class="brand-text">
          <strong>COPA ARTEMIS</strong>
          <small>EDICIÓN 2026</small>
        </span>
      </a>

      <nav class="nav-links" aria-label="Navegación principal">
        <a href="#inicio">Inicio</a>
        <a href="#informacion">Información</a>
        <button id="btn-rules" class="nav-button" type="button">
          Reglamento
        </button>
      </nav>

      <div class="nav-actions">
        <span class="online-indicator">
          <span class="status-dot"></span>
          <span id="player-count">ARTEMIS 2026</span>
        </span>

        <button
          id="btn-share"
          class="icon-button"
          type="button"
          aria-label="Compartir torneo"
          title="Compartir"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="18" cy="5" r="3"></circle>
            <circle cx="6" cy="12" r="3"></circle>
            <circle cx="18" cy="19" r="3"></circle>
            <path d="m8.7 10.7 6.6-4.4M8.7 13.3l6.6 4.4"></path>
          </svg>
        </button>

        <button
          id="btn-sound"
          class="icon-button"
          type="button"
          aria-label="Activar o desactivar sonido"
          title="Sonido"
        >
          <svg id="icon-vol-on" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M11 5 6 9H3v6h3l5 4z"></path>
            <path d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13"></path>
          </svg>
          <svg id="icon-vol-off" viewBox="0 0 24 24" aria-hidden="true" hidden>
            <path d="M11 5 6 9H3v6h3l5 4z"></path>
            <path d="m16 9 5 6m0-6-5 6"></path>
          </svg>
        </button>
      </div>
    </header>

    <main id="inicio">
      <section class="hero section-container">
        <div class="hero-content">
          <div class="eyebrow">
            <span class="status-dot"></span>
            EVENTO ESPECIAL · 2026
          </div>

          <h1>
            CONCURSO
            <span class="gradient-text">ARTEMIS</span>
            <span class="title-small">X CURI GAMEPLAYS</span>
          </h1>

          <p class="hero-description">
            Prepárate para demostrar tus habilidades, completar tu Pokédex
            y competir con otros entrenadores en la Copa Artemis.
          </p>

          <div class="hero-tags">
            <span class="tag">POKÉMON</span>
            <span class="tag">COMPETENCIA</span>
            <span class="tag">COMUNIDAD</span>
          </div>

          <div class="hero-buttons">
            <button id="btn-register" class="button button-primary" type="button">
              Inscribirme
              <span aria-hidden="true">↗</span>
            </button>

            <button
              id="btn-leaderboard"
              class="button button-secondary"
              type="button"
            >
              Ver clasificación
            </button>
          </div>

          <p class="hero-note">
            Únete a la comunidad y demuestra de qué eres capaz.
          </p>
        </div>

        <div class="hero-art" aria-label="Emblema de la Copa Artemis">
          <div class="orbit orbit-one"></div>
          <div class="orbit orbit-two"></div>
          <div class="art-glow"></div>

          <div class="art-card">
            <div class="art-topline">ARTEMIS PROJECT</div>
            <div class="art-symbol">A</div>
            <div class="art-divider"></div>
            <div class="art-name">COPA ARTEMIS</div>
            <div class="art-year">2026</div>
            <div class="art-footer">TRAINER COMPETITION</div>
          </div>

          <span class="floating-label label-top">#ARTEMIS2026</span>
          <span class="floating-label label-bottom">EVENTO ESPECIAL</span>
        </div>
      </section>

      <section class="countdown-section section-container">
        <div class="section-heading">
          <span class="section-kicker">CUENTA REGRESIVA</span>
          <h2>El evento te espera</h2>
        </div>

        <div class="countdown" aria-label="Cuenta regresiva del evento">
          <div class="time-card">
            <span id="t-days">00</span>
            <small>DÍAS</small>
          </div>
          <div class="time-card">
            <span id="t-hours">00</span>
            <small>HORAS</small>
          </div>
          <div class="time-card">
            <span id="t-minutes">00</span>
            <small>MINUTOS</small>
          </div>
          <div class="time-card">
            <span id="t-seconds">00</span>
            <small>SEGUNDOS</small>
          </div>
        </div>
      </section>

      <section class="features section-container">
        <article class="feature-card">
          <div class="feature-icon">✦</div>
          <span class="feature-number">01 / PARTICIPA</span>
          <h3>Inscripción abierta</h3>
          <p>
            Registra tu nombre de entrenador y tu usuario de Discord para
            participar en el evento.
          </p>
          <button class="text-button" data-open-register type="button">
            Registrarme <span aria-hidden="true">→</span>
          </button>
        </article>

        <article class="feature-card">
          <div class="feature-icon">◈</div>
          <span class="feature-number">02 / COMPITE</span>
          <h3>Completa tu Pokédex</h3>
          <p>
            Avanza en el desafío y consulta la clasificación de los
            participantes para seguir tu progreso.
          </p>
          <button id="btn-leaderboard-card" class="text-button" type="button">
            Ver clasificación <span aria-hidden="true">→</span>
          </button>
        </article>

        <article class="feature-card">
          <div class="feature-icon">⌘</div>
          <span class="feature-number">03 / CONECTA</span>
          <h3>Únete a Discord</h3>
          <p>
            Forma parte de la comunidad, consulta novedades y mantente
            informado sobre el concurso.
          </p>
          <a
            class="text-button"
            href={discordUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Entrar al servidor <span aria-hidden="true">↗</span>
          </a>
        </article>
      </section>

      <section id="informacion" class="details-section">
        <div class="section-container details-grid">
          <div>
            <span class="section-kicker">INFORMACIÓN OFICIAL</span>
            <h2>Tu próxima aventura comienza aquí.</h2>
            <p class="details-description">
              Revisa las fechas, sigue el reglamento y prepara tu inscripción
              para la Copa Artemis 2026.
            </p>

            <button id="btn-rules-details" class="button button-secondary" type="button">
              Consultar reglamento
            </button>
          </div>

          <div class="details-list">
            <div class="detail-item">
              <span class="detail-icon">▦</span>
              <div>
                <small>FECHAS DEL EVENTO</small>
                <strong>10 al 25 de octubre de 2026</strong>
              </div>
            </div>

            <div class="detail-item">
              <span class="detail-icon">◎</span>
              <div>
                <small>COMUNIDAD</small>
                <strong>Artemis x Curi Gameplays</strong>
              </div>
            </div>

            <div class="detail-item">
              <span class="detail-icon">⌘</span>
              <div>
                <small>SERVIDOR OFICIAL</small>
                <a href={discordUrl} target="_blank" rel="noopener noreferrer">
                  Discord de la comunidad ↗
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="discord-section section-container">
        <div class="discord-panel">
          <div>
            <span class="section-kicker">NO TE QUEDES FUERA</span>
            <h2>La comunidad te está esperando.</h2>
            <p>
              Entra al servidor oficial para conocer a los participantes y
              recibir información del concurso.
            </p>
          </div>

          <a
            class="button button-discord"
            href={discordUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M19.7 5.1a18 18 0 0 0-4.4-1.4l-.6 1.2a16 16 0 0 0-5.4 0l-.6-1.2a18 18 0 0 0-4.4 1.4C1.5 9.2.8 13.2 1.2 17.2a18 18 0 0 0 5.4 2.7l1.2-2a11 11 0 0 1-1.9-.9l.5-.4a13 13 0 0 0 11.2 0l.5.4a11 11 0 0 1-1.9.9l1.2 2a18 18 0 0 0 5.4-2.7c.5-4.7-.8-8.7-3.1-12.1ZM8.8 14.4c-1 0-1.8-.9-1.8-2s.8-2 1.8-2 1.8.9 1.8 2-.8 2-1.8 2Zm6.4 0c-1 0-1.8-.9-1.8-2s.8-2 1.8-2 1.8.9 1.8 2-.8 2-1.8 2Z"></path>
            </svg>
            Unirme a Discord
          </a>
        </div>
      </section>
    </main>

    <footer class="footer">
      <a class="brand footer-brand" href="#inicio">
        <span class="brand-icon">A</span>
        <span class="brand-text">
          <strong>COPA ARTEMIS</strong>
          <small>EDICIÓN 2026</small>
        </span>
      </a>

      <p>© 2026 Copa Artemis · Artemis x Curi Gameplays</p>
      <a href="#inicio">Volver arriba ↑</a>
    </footer>

    <!-- Modal de inscripción -->
    <div id="modal-register" class="modal" hidden>
      <div class="modal-backdrop" data-close-modal></div>

      <section
        class="modal-dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="register-title"
      >
        <button class="modal-close" type="button" data-close-modal aria-label="Cerrar">
          ×
        </button>

        <span class="section-kicker">COPA ARTEMIS 2026</span>
        <h2 id="register-title">Inscripción de entrenador</h2>
        <p class="modal-description">
          Completa tus datos para registrarte en el concurso.
        </p>

        <form id="register-form">
          <label for="nickname">Nombre de entrenador</label>
          <input
            id="nickname"
            name="nickname"
            type="text"
            maxlength="32"
            placeholder="Tu nombre de entrenador"
            required
          />

          <label for="discord">Usuario de Discord</label>
          <input
            id="discord"
            name="discord"
            type="text"
            maxlength="80"
            placeholder="Tu usuario de Discord"
            required
          />

          <label class="checkbox-label" for="accept-rules">
            <input id="accept-rules" name="accept-rules" type="checkbox" required />
            <span>He leído y acepto el reglamento del concurso.</span>
          </label>

          <button id="submit-register" class="button button-primary button-full" type="submit">
            Confirmar inscripción
          </button>
        </form>
      </section>
    </div>

    <!-- Modal del reglamento -->
    <div id="modal-rules" class="modal" hidden>
      <div class="modal-backdrop" data-close-modal></div>

      <section
        class="modal-dialog modal-dialog-wide"
        role="dialog"
        aria-modal="true"
        aria-labelledby="rules-title"
      >
        <button class="modal-close" type="button" data-close-modal aria-label="Cerrar">
          ×
        </button>

        <span class="section-kicker">NORMAS DEL EVENTO</span>
        <h2 id="rules-title">Reglamento</h2>

        <div class="rules-content">
          <h3>1. Inscripción</h3>
          <p>
            Cada participante debe proporcionar un nombre de entrenador y
            un usuario de Discord válidos.
          </p>

          <h3>2. Participación</h3>
          <p>
            Los participantes deben respetar las instrucciones y los
            procedimientos que anuncien los organizadores.
          </p>

          <h3>3. Juego limpio</h3>
          <p>
            No se permite hacer trampa, manipular resultados ni perjudicar
            deliberadamente a otros participantes.
          </p>

          <h3>4. Comunidad</h3>
          <p>
            Mantén un trato respetuoso con los organizadores y los demás
            entrenadores.
          </p>

          <h3>5. Actualizaciones</h3>
          <p>
            Consulta el servidor oficial de Discord para conocer cualquier
            cambio o aclaración de las reglas.
          </p>
        </div>

        <a
          class="button button-discord button-full"
          href={discordUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Consultar Discord
        </a>
      </section>
    </div>

    <!-- Modal de clasificación -->
    <div id="modal-leaderboard" class="modal" hidden>
      <div class="modal-backdrop" data-close-modal></div>

      <section
        class="modal-dialog modal-dialog-wide"
        role="dialog"
        aria-modal="true"
        aria-labelledby="leaderboard-title"
      >
        <button class="modal-close" type="button" data-close-modal aria-label="Cerrar">
          ×
        </button>

        <span class="section-kicker">RANKING DE PARTICIPANTES</span>
        <h2 id="leaderboard-title">Clasificación</h2>
        <p class="modal-description">
          Consulta el progreso registrado de los entrenadores.
        </p>

        <div class="leaderboard-header">
          <span>ENTRENADOR</span>
          <span>CAPTURAS</span>
        </div>

        <div id="leaderboard-list" class="leaderboard-list">
          <p class="empty-message">Cargando clasificación...</p>
        </div>
      </section>
    </div>
  </body>
</html>

<style>
  :root {
    color-scheme: dark;
    --bg: #080b14;
    --panel: #101626;
    --panel-light: #151d30;
    --text: #edf2ff;
    --muted: #9ba8c1;
    --accent: #a78bfa;
    --accent-bright: #c4b5fd;
    --border: rgba(167, 139, 250, 0.2);
    --cyan: #67e8f9;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 90px;
  }

  body {
    margin: 0;
    background:
      radial-gradient(ellipse at 50% 0%, rgba(91, 65, 170, 0.14), transparent 45%),
      var(--bg);
    color: var(--text);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    line-height: 1.6;
  }

  body:has(.modal:not([hidden])) {
    overflow: hidden;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button,
  input {
    font: inherit;
  }

  button,
  a {
    -webkit-tap-highlight-color: transparent;
  }

  button:focus-visible,
  a:focus-visible,
  input:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: 4px;
  }

  button {
    color: inherit;
  }

  .section-container {
    width: min(1120px, calc(100% - 40px));
    margin-inline: auto;
  }

  .navbar {
    position: sticky;
    z-index: 20;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 76px;
    padding: 12px max(20px, calc((100% - 1120px) / 2));
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    background: rgba(8, 11, 20, 0.88);
    backdrop-filter: blur(18px);
  }

  .brand {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 11px;
  }

  .brand-icon {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border: 1px solid var(--accent);
    border-radius: 12px;
    background: linear-gradient(145deg, #30245b, #101626);
    color: var(--accent-bright);
    font-size: 25px;
    font-weight: 900;
  }

  .brand-text {
    display: grid;
    line-height: 1.3;
  }

  .brand-text strong {
    font-size: 12px;
    letter-spacing: 1.4px;
  }

  .brand-text small {
    color: var(--muted);
    font-size: 10px;
    letter-spacing: 2px;
  }

  .nav-links,
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 23px;
  }

  .nav-links a,
  .nav-button {
    border: 0;
    background: none;
    color: var(--muted);
    cursor: pointer;
    font-size: 13px;
    transition: color 0.2s;
  }

  .nav-links a:hover,
  .nav-button:hover {
    color: var(--accent-bright);
  }

  .nav-actions {
    gap: 10px;
  }

  .online-indicator {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    font-size: 10px;
    letter-spacing: 1px;
  }

  .status-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    flex-shrink: 0;
    border-radius: 50%;
    background: #4ade80;
    box-shadow: 0 0 10px rgba(74, 222, 128, 0.6);
  }

  .icon-button {
    display: grid;
    width: 36px;
    height: 36px;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--panel);
    cursor: pointer;
  }

  .icon-button svg {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .hero {
    display: grid;
    min-height: 530px;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: 40px;
    padding-block: 70px 50px;
  }

  .eyebrow,
  .section-kicker {
    color: var(--accent-bright);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 2px;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 9px 13px;
    border: 1px solid var(--border);
    border-radius: 99px;
    background: rgba(167, 139, 250, 0.06);
  }

  h1 {
    margin: 24px 0 18px;
    font-size: clamp(40px, 6vw, 70px);
    font-weight: 900;
    letter-spacing: -3px;
    line-height: 0.99;
  }

  .gradient-text {
    display: block;
    background: linear-gradient(90deg, #c4b5fd, #818cf8, #67e8f9);
    background-clip: text;
    color: transparent;
  }

  .title-small {
    display: block;
    margin-top: 15px;
    color: var(--muted);
    font-size: clamp(13px, 1.7vw, 19px);
    font-weight: 700;
    letter-spacing: 4px;
  }

  .hero-description,
  .details-description {
    max-width: 520px;
    color: var(--muted);
    font-size: 15px;
  }

  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
  }

  .tag {
    padding: 6px 10px;
    border: 1px solid var(--border);
    border-radius: 6px;
    color: #cbd5e1;
    font-size: 9px;
    letter-spacing: 1px;
  }

  .hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .button {
    display: inline-flex;
    min-height: 45px;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 11px 18px;
    border: 1px solid transparent;
    border-radius: 9px;
    cursor: pointer;
    font-size: 13px;
    font-weight: 750;
    transition:
      transform 0.2s,
      background 0.2s,
      border-color 0.2s;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button-primary {
    background: linear-gradient(110deg, #a78bfa, #818cf8);
    color: #101020;
    box-shadow: 0 8px 25px rgba(129, 140, 248, 0.17);
  }

  .button-primary:hover {
    background: linear-gradient(110deg, #c4b5fd, #a5b4fc);
  }

  .button-secondary {
    border-color: var(--border);
    background: rgba(255, 255, 255, 0.025);
    color: var(--text);
  }

  .button-secondary:hover {
    border-color: var(--accent);
    background: rgba(167, 139, 250, 0.08);
  }

  .hero-note {
    margin-top: 19px;
    color: #76839c;
    font-size: 11px;
  }

  .hero-art {
    position: relative;
    display: grid;
    min-height: 370px;
    place-items: center;
    isolation: isolate;
  }

  .art-glow {
    position: absolute;
    z-index: -1;
    width: 260px;
    height: 260px;
    border-radius: 50%;
    background: #7861dd;
    filter: blur(100px);
    opacity: 0.24;
  }

  .orbit {
    position: absolute;
    width: 310px;
    height: 310px;
    border: 1px solid rgba(167, 139, 250, 0.2);
    border-radius: 50%;
    transform: rotate(-25deg) scaleY(0.5);
  }

  .orbit-two {
    width: 360px;
    height: 360px;
    transform: rotate(35deg) scaleY(0.45);
  }

  .art-card {
    display: flex;
    width: 235px;
    min-height: 295px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(196, 181, 253, 0.5);
    border-radius: 18px;
    background: linear-gradient(145deg, #1b2040, #0c1120 70%);
    box-shadow:
      0 0 0 8px rgba(167, 139, 250, 0.025),
      0 25px 70px rgba(0, 0, 0, 0.4);
    transform: rotate(-5deg);
  }

  .art-topline,
  .art-footer {
    color: #a5b4fc;
    font-size: 8px;
    letter-spacing: 2px;
  }

  .art-symbol {
    display: grid;
    width: 115px;
    height: 135px;
    place-items: center;
    margin: 12px 0;
    background: linear-gradient(145deg, #c4b5fd, #818cf8 60%, #67e8f9);
    background-clip: text;
    color: transparent;
    font-size: 120px;
    font-weight: 900;
    line-height: 1;
    text-shadow: 0 0 35px rgba(167, 139, 250, 0.1);
  }

  .art-divider {
    width: 70%;
