---
const title = "Copa Artemis 2026";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>

    <meta
      name="description"
      content="Copa Artemis 2026 — Competencia Pokémon."
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800&family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- SUPABASE CDN -->
    <script
      src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"
    ></script>

    <style>
      :root {
        --bg: #07080c;
        --bg-2: #0c0e14;
        --card: rgba(19, 21, 29, 0.88);
        --card-2: rgba(25, 27, 37, 0.92);
        --gold: #d6b35a;
        --gold-light: #f0d88b;
        --silver: #c6cad4;
        --text: #f5f5f7;
        --muted: #9da2ae;
        --border: rgba(214, 179, 90, 0.22);
        --danger: #ff6464;
        --success: #61d89a;
        --shadow: 0 20px 60px rgba(0, 0, 0, 0.45);
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        min-height: 100vh;
        background:
          radial-gradient(
            circle at 50% 0%,
            rgba(214, 179, 90, 0.09),
            transparent 35%
          ),
          radial-gradient(
            circle at 10% 40%,
            rgba(93, 68, 180, 0.08),
            transparent 30%
          ),
          var(--bg);
        color: var(--text);
        font-family: "Inter", sans-serif;
        overflow-x: hidden;
      }

      body::before {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        background-image:
          linear-gradient(
            rgba(255, 255, 255, 0.015) 1px,
            transparent 1px
          ),
          linear-gradient(
            90deg,
            rgba(255, 255, 255, 0.015) 1px,
            transparent 1px
          );
        background-size: 50px 50px;
        mask-image: linear-gradient(to bottom, black, transparent);
        z-index: -1;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      button,
      input {
        font: inherit;
      }

      button {
        cursor: pointer;
      }

      /* =========================
         NAVBAR
      ========================= */

      .navbar {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 100;
        height: 72px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 5%;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        background: rgba(7, 8, 12, 0.84);
        backdrop-filter: blur(18px);
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .brand-symbol {
        width: 38px;
        height: 38px;
        display: grid;
        place-items: center;
        border: 1px solid var(--gold);
        border-radius: 50%;
        color: var(--gold-light);
        font-family: "Cinzel", serif;
        font-weight: 800;
        box-shadow: 0 0 20px rgba(214, 179, 90, 0.12);
      }

      .brand-text {
        font-family: "Cinzel", serif;
        font-size: 15px;
        letter-spacing: 0.12em;
        font-weight: 800;
      }

      .nav-actions {
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .nav-btn {
        border: 1px solid rgba(255, 255, 255, 0.1);
        background: rgba(255, 255, 255, 0.035);
        color: var(--silver);
        padding: 9px 14px;
        border-radius: 10px;
        transition: 0.2s ease;
      }

      .nav-btn:hover {
        color: var(--gold-light);
        border-color: var(--border);
        transform: translateY(-1px);
      }

      .discord-btn {
        border-color: rgba(88, 101, 242, 0.35);
      }

      /* =========================
         HERO
      ========================= */

      .hero {
        min-height: 720px;
        padding: 145px 20px 90px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
      }

      .hero::before {
        content: "";
        position: absolute;
        width: 650px;
        height: 650px;
        border-radius: 50%;
        background: radial-gradient(
          circle,
          rgba(214, 179, 90, 0.1),
          transparent 68%
        );
        top: -220px;
        left: 50%;
        transform: translateX(-50%);
        pointer-events: none;
      }

      .hero-content {
        width: min(1100px, 100%);
        text-align: center;
        position: relative;
        z-index: 2;
      }

      .eyebrow {
        color: var(--gold);
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        margin-bottom: 20px;
      }

      .hero h1 {
        font-family: "Cinzel", serif;
        font-size: clamp(42px, 8vw, 86px);
        line-height: 0.95;
        letter-spacing: -0.04em;
        margin-bottom: 24px;
        background: linear-gradient(
          120deg,
          #fff,
          var(--gold-light),
          #fff
        );
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }

      .hero-description {
        max-width: 670px;
        margin: 0 auto;
        color: var(--muted);
        font-size: 16px;
        line-height: 1.8;
      }

      .hero-actions {
        display: flex;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 35px;
      }

      .primary-btn,
      .secondary-btn {
        border-radius: 12px;
        padding: 13px 22px;
        font-weight: 800;
        transition: 0.2s ease;
      }

      .primary-btn {
        border: 1px solid var(--gold);
        color: #111;
        background: linear-gradient(
          135deg,
          var(--gold-light),
          var(--gold)
        );
        box-shadow: 0 10px 30px rgba(214, 179, 90, 0.14);
      }

      .primary-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 15px 35px rgba(214, 179, 90, 0.22);
      }

      .secondary-btn {
        border: 1px solid rgba(255, 255, 255, 0.13);
        color: var(--text);
        background: rgba(255, 255, 255, 0.045);
      }

      .secondary-btn:hover {
        border-color: var(--border);
        color: var(--gold-light);
        transform: translateY(-2px);
      }

      /* =========================
         COUNTDOWN
      ========================= */

      .countdown {
        width: min(850px, 100%);
        margin: 55px auto 0;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
      }

      .count-card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 15px;
        padding: 19px 10px;
        box-shadow: var(--shadow);
      }

      .count-number {
        font-family: "Cinzel", serif;
        color: var(--gold-light);
        font-size: 32px;
        font-weight: 800;
      }

      .count-label {
        color: var(--muted);
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.16em;
        margin-top: 5px;
      }

      /* =========================
         SECTION
      ========================= */

      .section {
        width: min(1100px, calc(100% - 40px));
        margin: 0 auto;
        padding: 70px 0;
      }

      .section-heading {
        text-align: center;
        margin-bottom: 35px;
      }

      .section-heading span {
        color: var(--gold);
        font-size: 11px;
        letter-spacing: 0.25em;
        text-transform: uppercase;
        font-weight: 800;
      }

      .section-heading h2 {
        font-family: "Cinzel", serif;
        font-size: clamp(28px, 5vw, 42px);
        margin-top: 10px;
      }

      .features {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
      }

      .feature-card {
        padding: 28px;
        border-radius: 18px;
        background: linear-gradient(
          145deg,
          rgba(24, 26, 35, 0.94),
          rgba(12, 14, 20, 0.94)
        );
        border: 1px solid rgba(255, 255, 255, 0.07);
        transition: 0.25s ease;
      }

      .feature-card:hover {
        border-color: var(--border);
        transform: translateY(-4px);
      }

      .feature-icon {
        width: 45px;
        height: 45px;
        display: grid;
        place-items: center;
        border-radius: 12px;
        border: 1px solid var(--border);
        color: var(--gold-light);
        margin-bottom: 20px;
        font-size: 20px;
      }

      .feature-card h3 {
        font-family: "Cinzel", serif;
        margin-bottom: 10px;
      }

      .feature-card p {
        color: var(--muted);
        line-height: 1.7;
        font-size: 14px;
      }

      /* =========================
         PLAYER STATUS
      ========================= */

      .player-status {
        display: flex;
        justify-content: center;
        margin-top: 35px;
      }

      .player-count-box {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 9px 15px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.035);
        border: 1px solid rgba(255, 255, 255, 0.08);
        color: var(--muted);
        font-size: 13px;
      }

      .online-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--success);
        box-shadow: 0 0 12px rgba(97, 216, 154, 0.6);
      }

      /* =========================
         FOOTER
      ========================= */

      footer {
        padding: 55px 20px;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
        text-align: center;
        color: var(--muted);
        font-size: 13px;
      }

      .footer-title {
        color: var(--gold-light);
        font-family: "Cinzel", serif;
        font-weight: 800;
        margin-bottom: 8px;
      }

      /* =========================
         MODAL
      ========================= */

      .modal {
        position: fixed;
        inset: 0;
        z-index: 500;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(0, 0, 0, 0.75);
        backdrop-filter: blur(8px);
      }

      .modal.active {
        display: flex;
      }

      .modal-content {
        width: min(550px, 100%);
        max-height: 90vh;
        overflow-y: auto;
        background:
          radial-gradient(
            circle at top right,
            rgba(214, 179, 90, 0.08),
            transparent 35%
          ),
          var(--bg-2);
        border: 1px solid var(--border);
        border-radius: 20px;
        box-shadow: 0 30px 100px rgba(0, 0, 0, 0.7);
        padding: 28px;
        position: relative;
      }

      .modal-close {
        position: absolute;
        right: 17px;
        top: 15px;
        width: 35px;
        height: 35px;
        border-radius: 50%;
        border: 1px solid rgba(255, 255, 255, 0.08);
        color: var(--muted);
        background: rgba(255, 255, 255, 0.04);
        font-size: 18px;
      }

      .modal-title {
        font-family: "Cinzel", serif;
        color: var(--gold-light);
        font-size: 27px;
        margin-bottom: 7px;
      }

      .modal-subtitle {
        color: var(--muted);
        font-size: 13px;
        line-height: 1.6;
        margin-bottom: 25px;
      }

      .form-group {
        margin-bottom: 17px;
      }

      .form-group label {
        display: block;
        font-size: 12px;
        font-weight: 700;
        color: var(--silver);
        margin-bottom: 7px;
      }

      .form-input {
        width: 100%;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 11px;
        padding: 13px 14px;
        background: rgba(255, 255, 255, 0.04);
        color: white;
        outline: none;
      }

      .form-input:focus {
        border-color: var(--gold);
        box-shadow: 0 0 0 3px rgba(214, 179, 90, 0.08);
      }

      .checkbox-row {
        display: flex;
        gap: 10px;
        align-items: flex-start;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.6;
        margin: 18px 0;
      }

      .checkbox-row input {
        margin-top: 3px;
        accent-color: var(--gold);
      }

      .form-message {
        min-height: 20px;
        margin-top: 13px;
        text-align: center;
        font-size: 12px;
      }

      .form-message.error {
        color: var(--danger);
      }

      .form-message.success {
        color: var(--success);
      }

      /* =========================
         LEADERBOARD
      ========================= */

      .leaderboard {
        display: flex;
        flex-direction: column;
        gap: 9px;
      }

      .leaderboard-row {
        display: grid;
        grid-template-columns: 42px 1fr auto;
        align-items: center;
        gap: 12px;
        padding: 13px;
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.06);
        background: rgba(255, 255, 255, 0.025);
      }

      .leaderboard-position {
        width: 32px;
        height: 32px;
        display: grid;
        place-items: center;
        border-radius: 9px;
        color: var(--gold-light);
        font-weight: 800;
        background: rgba(214, 179, 90, 0.08);
      }

      .leaderboard-name {
        font-weight: 800;
        font-size: 14px;
      }

      .leaderboard-region {
        color: var(--muted);
        font-size: 10px;
        margin-top: 3px;
      }

      .leaderboard-count {
        color: var(--gold-light);
        font-family: "Cinzel", serif;
        font-weight: 800;
        white-space: nowrap;
      }

      .empty-state {
        padding: 35px 15px;
        text-align: center;
        color: var(--muted);
        font-size: 13px;
      }

      /* =========================
         TOAST
      ========================= */

      .toast-container {
        position: fixed;
        right: 18px;
        bottom: 18px;
        z-index: 1000;
        display: flex;
        flex-direction: column;
        gap: 9px;
        width: min(390px, calc(100% - 36px));
      }

      .toast {
        padding: 14px 16px;
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        background: #151821;
        box-shadow: var(--shadow);
        color: var(--text);
        font-size: 13px;
        line-height: 1.5;
        animation: toastIn 0.25s ease;
      }

      .toast.error {
        border-color: rgba(255, 100, 100, 0.3);
      }

      .toast.success {
        border-color: rgba(97, 216, 154, 0.3);
      }

      @keyframes toastIn {
        from {
          opacity: 0;
          transform: translateY(10px);
        }

        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      /* =========================
         RESPONSIVE
      ========================= */

      @media (max-width: 800px) {
        .features {
          grid-template-columns: 1fr;
        }

        .navbar {
          padding: 0 18px;
        }

        .brand-text {
          display: none;
        }

        .nav-btn {
          padding: 8px 10px;
          font-size: 12px;
        }
      }

      @media (max-width: 600px) {
        .hero {
          min-height: auto;
          padding-top: 125px;
        }

        .countdown {
          grid-template-columns: repeat(2, 1fr);
        }

        .hero-actions {
          flex-direction: column;
          align-items: stretch;
        }

        .hero-actions button,
        .hero-actions a {
          width: 100%;
        }

        .section {
          width: min(100% - 28px, 1100px);
        }

        .modal-content {
          padding: 22px;
        }
      }
    </style>
  </head>

  <body>
    <!-- =========================
         NAVBAR
    ========================== -->

    <nav class="navbar">
      <a href="#" class="brand">
        <div class="brand-symbol">A</div>

        <div class="brand-text">
          COPA ARTEMIS
        </div>
      </a>

      <div class="nav-actions">
        <button
          class="nav-btn"
          id="leaderboardBtn"
          type="button"
        >
          Clasificación
        </button>

        <button
          class="nav-btn"
          id="rulesBtn"
          type="button"
        >
          Reglas
        </button>

        <a
          class="nav-btn discord-btn"
          href="https://discord.gg/3GWTVzjHS4"
          target="_blank"
          rel="noopener noreferrer"
        >
          Discord
        </a>
      </div>
    </nav>

    <!-- =========================
         HERO
    ========================== -->

    <main>
      <section class="hero">
        <div class="hero-content">
          <div class="eyebrow">
            Competencia Pokémon
          </div>

          <h1>
            COPA ARTEMIS
            <br />
            2026
          </h1>

          <p class="hero-description">
            Una competencia para entrenadores. Demuestra tu progreso,
            completa tu Pokédex y alcanza la cima de la clasificación.
          </p>

          <div class="hero-actions">
            <button
              class="primary-btn"
              id="registerBtn"
              type="button"
            >
              Registrarme
            </button>

            <button
              class="secondary-btn"
              id="heroLeaderboardBtn"
              type="button"
            >
              Ver clasificación
            </button>
          </div>

          <div class="countdown">
            <div class="count-card">
              <div
                class="count-number"
                id="days"
              >
                00
              </div>

              <div class="count-label">
                Días
              </div>
            </div>

            <div class="count-card">
              <div
                class="count-number"
                id="hours"
              >
                00
              </div>

              <div class="count-label">
                Horas
              </div>
            </div>

            <div class="count-card">
              <div
                class="count-number"
                id="minutes"
              >
                00
              </div>

              <div class="count-label">
                Minutos
              </div>
            </div>

            <div class="count-card">
              <div
                class="count-number"
                id="seconds"
              >
                00
              </div>

              <div class="count-label">
                Segundos
              </div>
            </div>
          </div>

          <div class="player-status">
            <div class="player-count-box">
              <span class="online-dot"></span>

              <span>
                <strong id="playerCount">
                  0
                </strong>
                entrenadores registrados
              </span>
            </div>
          </div>
        </div>
      </section>

      <!-- =========================
           FEATURES
      ========================== -->

      <section class="section">
        <div class="section-heading">
          <span>
            La competencia
          </span>

          <h2>
            Elige tu camino
          </h2>
        </div>

        <div class="features">
          <article class="feature-card">
            <div class="feature-icon">
              ⚔
            </div>

            <h3>
              Compite
            </h3>

            <p>
              Entra a la competencia y demuestra que puedes llegar
              hasta lo más alto de la clasificación.
            </p>
          </article>

          <article class="feature-card">
            <div class="feature-icon">
              ◈
            </div>

            <h3>
              Completa
            </h3>

            <p>
              Registra tus capturas y aumenta progresivamente tu
              porcentaje de Pokédex completada.
            </p>
          </article>

          <article class="feature-card">
            <div class="feature-icon">
              ♛
            </div>

            <h3>
              Conquista
            </h3>

            <p>
              Supera a los demás entrenadores y lucha por ocupar
              el primer lugar.
            </p>
          </article>
        </div>
      </section>
    </main>

    <!-- =========================
         REGISTRO MODAL
    ========================== -->

    <div
      class="modal"
      id="registerModal"
      aria-hidden="true"
    >
      <div class="modal-content">
        <button
          class="modal-close"
          id="closeRegister"
          type="button"
          aria-label="Cerrar"
        >
          ×
        </button>

        <h2 class="modal-title">
          Registro
        </h2>

        <p class="modal-subtitle">
          Regístrate como entrenador para aparecer en la Copa Artemis 2026.
        </p>

        <form id="registerForm">
          <div class="form-group">
            <label for="reg-nick">
              Nickname
            </label>

            <input
              class="form-input"
              id="reg-nick"
              type="text"
              maxlength="40"
              autocomplete="nickname"
              placeholder="Tu nickname"
              required
            />
          </div>

          <div class="form-group">
            <label for="reg-discord">
              Usuario de Discord
            </label>

            <input
              class="form-input"
              id="reg-discord"
              type="text"
              maxlength="80"
              placeholder="tu_usuario"
              required
            />
          </div>

          <label class="checkbox-row">
            <input
              id="reg-rules"
              type="checkbox"
              required
            />

            <span>
              Confirmo que he leído y acepto las reglas de la
              Copa Artemis 2026.
            </span>
          </label>

          <button
            class="primary-btn"
            id="submitRegister"
            type="submit"
            style="width: 100%;"
          >
            Registrar entrenador
          </button>

          <div
            class="form-message"
            id="registerMessage"
          ></div>
        </form>
      </div>
    </div>

    <!-- =========================
         REGLAS MODAL
    ========================== -->

    <div
      class="modal"
      id="rulesModal"
      aria-hidden="true"
    >
      <div class="modal-content">
        <button
          class="modal-close"
          id="closeRules"
          type="button"
          aria-label="Cerrar"
        >
          ×
        </button>

        <h2 class="modal-title">
          Reglas
        </h2>

        <p class="modal-subtitle">
          Reglas generales de la Copa Artemis 2026.
        </p>

        <div
          style="
            color: #aeb2bd;
            font-size: 14px;
            line-height: 1.8;
          "
        >
          <p>
            <strong style="color:#f0d88b;">
              1. Registro
            </strong>
          </p>

          <p>
            Cada entrenador deberá registrarse con un nickname
            y un usuario de Discord válido.
          </p>

          <br />

          <p>
            <strong style="color:#f0d88b;">
              2. Progreso
            </strong>
          </p>

          <p>
            El progreso de cada entrenador se registra mediante
            la cantidad de Pokémon capturados.
          </p>

          <br />

          <p>
            <strong style="color:#f0d88b;">
              3. Clasificación
            </strong>
          </p>

          <p>
            La clasificación se determina según el progreso
            registrado de cada participante.
          </p>

          <br />

          <p>
            <strong style="color:#f0d88b;">
              4. Comunidad
            </strong>
          </p>

          <p>
            Toda comunicación oficial de la competencia se
            realizará mediante el servidor de Discord.
          </p>
        </div>
      </div>
    </div>

    <!-- =========================
         LEADERBOARD MODAL
    ========================== -->

    <div
      class="modal"
      id="leaderboardModal"
      aria-hidden="true"
    >
      <div class="modal-content">
        <button
          class="modal-close"
          id="closeLeaderboard"
          type="button"
          aria-label="Cerrar"
        >
          ×
        </button>

        <h2 class="modal-title">
          Clasificación
        </h2>

        <p class="modal-subtitle">
          Entrenadores ordenados por Pokémon capturados.
        </p>

        <div
          class="leaderboard"
          id="leaderboard"
        >
          <div class="empty-state">
            Cargando clasificación...
          </div>
        </div>
      </div>
    </div>

    <!-- =========================
         TOASTS
    ========================== -->

    <div
      class="toast-container"
      id="toastContainer"
    ></div>

    <footer>
      <div class="footer-title">
        COPA ARTEMIS 2026
      </div>

      <p>
        Una competencia para entrenadores.
      </p>
    </footer>

    <script is:inline>
      // =========================================================
      // CONFIGURACIÓN SUPABASE
      // =========================================================

      const SUPABASE_URL =
        'https://flldgvplxxogaqdmvhkb.supabase.co';

      const SUPABASE_PUBLISHABLE_KEY =
        'sb_publishable_xak3DICWNkTS2ibbeeixLg_9vEcgDjc';

      const $ = (id) =>
        document.getElementById(id);

      let supabaseClient = null;


      // =========================================================
      // INICIALIZAR SUPABASE
      // =========================================================

      function initializeSupabase() {

        if (
          !window.supabase ||
          typeof window.supabase.createClient !== 'function'
        ) {

          console.error(
            'No se pudo cargar la librería de Supabase.'
          );

          showToast(
            'No se pudo cargar Supabase. Revisa el CDN.',
            'error'
          );

          return false;
        }

        if (!supabaseClient) {

          supabaseClient =
            window.supabase.createClient(
              SUPABASE_URL,
              SUPABASE_PUBLISHABLE_KEY
            );

          console.log(
            'Supabase inicializado correctamente.'
          );
        }

        return true;
      }


      // =========================================================
      // TOAST
      // =========================================================

      function showToast(message, type = 'success') {

        const container =
          $('toastContainer');

        if (!container) return;

        const toast =
          document.createElement('div');

        toast.className =
          `toast ${type}`;

        toast.textContent =
          message;

        container.appendChild(toast);

        setTimeout(() => {

          toast.style.opacity = '0';
          toast.style.transform =
            'translateY(10px)';

          setTimeout(() => {
            toast.remove();
          }, 250);

        }, 4500);
      }


      // =========================================================
      // ERROR SUPABASE
      // =========================================================

      function getSupabaseErrorMessage(error) {

        if (!error) {
          return 'Ocurrió un error desconocido.';
        }

        const message =
          error.message ||
          error.details ||
          error.hint ||
          String(error);

        const lower =
          message.toLowerCase();


        if (
          lower.includes('relation') &&
          lower.includes('does not exist')
        ) {

          return (
            'Supabase no encuentra una de las tablas. ' +
            'Verifica que las tablas "entrenadores" y "progreso" ' +
            'estén creadas en el esquema public.'
          );
        }


        if (
          lower.includes('could not find the table')
        ) {

          return (
            'Supabase no encuentra la tabla. ' +
            'Verifica el nombre exacto y que esté dentro del esquema public.'
          );
        }


        if (
          lower.includes('row-level security') ||
          lower.includes('permission denied') ||
          lower.includes('42501')
        ) {

          return (
            'La tabla existe, pero Supabase está bloqueando ' +
            'el acceso por permisos o RLS.'
          );
        }


        if (
          lower.includes('duplicate') ||
          lower.includes('unique constraint')
        ) {

          return (
            'Este entrenador ya está registrado.'
          );
        }


        return message;
      }


      // =========================================================
      // ESCAPAR HTML
      // =========================================================

      function escapeHtml(value) {

        return String(value ?? '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');
      }


      // =========================================================
      // CARGAR CANTIDAD DE ENTRENADORES
      // =========================================================

      async function loadPlayerCount() {

        if (!initializeSupabase()) {
          return;
        }

        const {
          count,
          error
        } = await supabaseClient
          .from('entrenadores')
          .select('id', {
            count: 'exact',
            head: true
          });


        if (error) {

          console.error(
            'Error contando entrenadores:',
            error
          );

          return;
        }


        if ($('playerCount')) {

          $('playerCount').textContent =
            String(count || 0);
        }
      }


      // =========================================================
      // CARGAR CLASIFICACIÓN
      // =========================================================

      async function loadLeaderboard() {

        const leaderboard =
          $('leaderboard');

        if (!leaderboard) {
          return;
        }


        leaderboard.innerHTML = `
          <div class="empty-state">
            Cargando clasificación...
          </div>
        `;


        if (!initializeSupabase()) {

          leaderboard.innerHTML = `
            <div class="empty-state">
              No se pudo conectar con Supabase.
            </div>
          `;

          return;
        }


        try {

          // -----------------------------------------------------
          // 1. OBTENER ENTRENADORES
          // -----------------------------------------------------

          const {
            data: trainers,
            error: trainersError
          } = await supabaseClient
            .from('entrenadores')
            .select(
              `
                id,
                nickname,
                discord_user,
                avatar,
                region,
                status,
                accepted_rules,
                created_at
              `
            )
            .order(
              'created_at',
              {
                ascending: true
              }
            );


          if (trainersError) {
            throw new Error(
              `entrenadores: ${getSupabaseErrorMessage(trainersError)}`
            );
          }


          if (!trainers || trainers.length === 0) {

            leaderboard.innerHTML = `
              <div class="empty-state">
                Todavía no hay entrenadores registrados.
              </div>
            `;

            if ($('playerCount')) {
              $('playerCount').textContent = '0';
            }

            return;
          }


          // -----------------------------------------------------
          // 2. OBTENER IDS
          // -----------------------------------------------------

          const trainerIds =
            trainers.map(
              trainer => trainer.id
            );


          // -----------------------------------------------------
          // 3. OBTENER PROGRESO
          // -----------------------------------------------------

          const {
            data: progressRows,
            error: progressError
          } = await supabaseClient
            .from('progreso')
            .select(
              `
                id,
                trainer_id,
                pokemon_caught,
                total_pokedex,
                updated_at
              `
            )
            .in(
              'trainer_id',
              trainerIds
            );


          if (progressError) {
            throw new Error(
              `progreso: ${getSupabaseErrorMessage(progressError)}`
            );
          }


          // -----------------------------------------------------
          // 4. MAPEAR PROGRESO
          // -----------------------------------------------------

          const progressMap =
            new Map();

          (progressRows || [])
            .forEach(progress => {

              progressMap.set(
                String(progress.trainer_id),
                progress
              );

            });


          // -----------------------------------------------------
          // 5. COMBINAR DATOS
          // -----------------------------------------------------

          const combined =
            trainers.map(trainer => {

              const progress =
                progressMap.get(
                  String(trainer.id)
                );

              return {
                trainer,
                progress
              };

            });


          // -----------------------------------------------------
          // 6. ORDENAR POR POKÉMON CAPTURADOS
          // -----------------------------------------------------

          combined.sort(
            (a, b) => {

              const aCaught =
                Number(
                  a.progress?.pokemon_caught || 0
                );

              const bCaught =
                Number(
                  b.progress?.pokemon_caught || 0
                );

              if (
                bCaught !== aCaught
              ) {
                return bCaught - aCaught;
              }


              const aDate =
                new Date(
                  a.trainer.created_at
                ).getTime();

              const bDate =
                new Date(
                  b.trainer.created_at
                ).getTime();

              return aDate - bDate;
            }
          );


          // -----------------------------------------------------
          // 7. MOSTRAR
          // -----------------------------------------------------

          leaderboard.innerHTML =
            combined
              .map(
                (item, index) => {

                  const trainer =
                    item.trainer;

                  const progress =
                    item.progress;


                  const captures =
                    Number(
                      progress?.pokemon_caught || 0
                    );


                  const total =
                    Number(
                      progress?.total_pokedex || 0
                    );


                  const region =
                    trainer.region ||
                    'Ketzal';


                  const nickname =
                    escapeHtml(
                      trainer.nickname ||
                      'Entrenador'
                    );


                  const safeRegion =
                    escapeHtml(
                      region
                    );


                  return `
                    <div class="leaderboard-row">

                      <div class="leaderboard-position">
                        ${index + 1}
                      </div>

                      <div>

                        <div class="leaderboard-name">
                          ${nickname}
                        </div>

                        <div class="leaderboard-region">
                          ${safeRegion}
                        </div>

                      </div>

                      <span class="leaderboard-count">
                        ${captures}/${total}
                      </span>

                    </div>
                  `;
                }
              )
              .join('');


          if ($('playerCount')) {

            $('playerCount').textContent =
              String(trainers.length);
          }


        } catch (error) {

          console.error(
            'Error al cargar la clasificación:',
            error
          );


          leaderboard.innerHTML = `
            <div class="empty-state">
              <strong style="color:#ff6464;">
                Error al cargar la clasificación.
              </strong>

              <br /><br />

              <span>
                ${escapeHtml(
                  error.message ||
                  String(error)
                )}
              </span>
            </div>
          `;

          showToast(
            error.message ||
            'Error al cargar las tablas de Supabase.',
            'error'
          );
        }
      }


      // =========================================================
      // REGISTRAR ENTRENADOR
      // =========================================================

      async function registerTrainer(event) {

        event.preventDefault();


        const nickInput =
          $('reg-nick');

        const discordInput =
          $('reg-discord');

        const rulesInput =
          $('reg-rules');

        const submitButton =
          $('submitRegister');

        const message =
          $('registerMessage');


        const nick =
          nickInput.value.trim();

        const discord =
          discordInput.value.trim();

        const acceptedRules =
          rulesInput.checked;


        message.className =
          'form-message';

        message.textContent =
          '';


        // -------------------------------------------------------
        // VALIDACIONES
        // -------------------------------------------------------

        if (!nick) {

          message.classList.add('error');

          message.textContent =
            'Escribe tu nickname.';

          return;
        }


        if (!discord) {

          message.classList.add('error');

          message.textContent =
            'Escribe tu usuario de Discord.';

          return;
        }


        if (!acceptedRules) {

          message.classList.add('error');

          message.textContent =
            'Debes aceptar las reglas.';

          return;
        }


        if (!initializeSupabase()) {

          message.classList.add('error');

          message.textContent =
            'No se pudo conectar con Supabase.';

          return;
        }


        submitButton.disabled = true;

        submitButton.textContent =
          'Registrando...';


        try {

          // -----------------------------------------------------
          // 1. CREAR ENTRENADOR
          // -----------------------------------------------------

          const {
            data: trainer,
            error: trainerError
          } = await supabaseClient
            .from('entrenadores')
            .insert([
              {
                nickname: nick,

                discord_user:
                  discord,

                avatar:
                  '',

                region:
                  'Ketzal',

                status:
                  'active',

                accepted_rules:
                  true
              }
            ])
            .select()
            .single();


          if (trainerError) {

            throw new Error(
              `entrenadores: ${getSupabaseErrorMessage(trainerError)}`
            );
          }


          if (!trainer?.id) {

            throw new Error(
              'Supabase creó el entrenador pero no devolvió su ID.'
            );
          }


          console.log(
            'Entrenador creado:',
            trainer
          );


          // -----------------------------------------------------
          // 2. CREAR PROGRESO
          // -----------------------------------------------------

          const {
            data: progress,
            error: progressError
          } = await supabaseClient
            .from('progreso')
            .insert([
              {
                trainer_id:
                  trainer.id,

                pokemon_caught:
                  0,

                total_pokedex:
                  200,

                updated_at:
                  new Date().toISOString()
              }
            ])
            .select()
            .single();


          if (progressError) {

            // Intentar eliminar el entrenador creado
            // si el progreso no pudo crearse.

            console.error(
              'No se pudo crear progreso:',
              progressError
            );

            throw new Error(
              `progreso: ${getSupabaseErrorMessage(progressError)}`
            );
          }


          console.log(
            'Progreso creado:',
            progress
          );


          // -----------------------------------------------------
          // ÉXITO
          // -----------------------------------------------------

          message.classList.add(
            'success'
          );

          message.textContent =
            '¡Registro completado correctamente!';


          showToast(
            '¡Entrenador registrado correctamente!',
            'success'
          );


          $('registerForm').reset();


          await loadPlayerCount();


          setTimeout(() => {

            closeModal(
              $('registerModal')
            );

          }, 1400);


        } catch (error) {

          console.error(
            'Error durante el registro:',
            error
          );


          message.classList.add(
            'error'
          );

          message.textContent =
            error.message ||
            'No se pudo completar el registro.';


          showToast(
            error.message ||
            'Error durante el registro.',
            'error'
          );


        } finally {

          submitButton.disabled =
            false;

          submitButton.textContent =
            'Registrar entrenador';
        }
      }


      // =========================================================
      // MODALES
      // =========================================================

      function openModal(modal) {

        if (!modal) return;

        modal.classList.add(
          'active'
        );

        modal.setAttribute(
          'aria-hidden',
          'false'
        );

        document.body.style.overflow =
          'hidden';
      }


      function closeModal(modal) {

        if (!modal) return;

        modal.classList.remove(
          'active'
        );

        modal.setAttribute(
          'aria-hidden',
          'true'
        );

        document.body.style.overflow =
          '';
      }


      // =========================================================
      // COUNTDOWN
      // =========================================================

      const tournamentStart =
        new Date(
          '2026-10-10T16:00:00-06:00'
        ).getTime();


      const tournamentEnd =
        new Date(
          '2026-10-25T23:59:59-06:00'
        ).getTime();


      function updateCountdown() {

        const now =
          Date.now();


        let difference;


        // Antes del inicio
        if (
          now < tournamentStart
        ) {

          difference =
            tournamentStart - now;

        }

        // Durante el torneo
        else if (
          now < tournamentEnd
        ) {

          difference =
            tournamentEnd - now;

        }

        // Finalizado
        else {

          difference = 0;
        }


        const days =
          Math.floor(
            difference /
            (1000 * 60 * 60 * 24)
          );


        const hours =
          Math.floor(
            (
              difference %
              (1000 * 60 * 60 * 24)
            ) /
            (1000 * 60 * 60)
          );


        const minutes =
          Math.floor(
            (
              difference %
              (1000 * 60 * 60)
            ) /
            (1000 * 60)
          );


        const seconds =
          Math.floor(
            (
              difference %
              (1000 * 60)
            ) /
            1000
          );


        if ($('days')) {
          $('days').textContent =
            String(days).padStart(2, '0');
        }

        if ($('hours')) {
          $('hours').textContent =
            String(hours).padStart(2, '0');
        }

        if ($('minutes')) {
          $('minutes').textContent =
            String(minutes).padStart(2, '0');
        }

        if ($('seconds')) {
          $('seconds').textContent =
            String(seconds).padStart(2, '0');
        }
      }


      // =========================================================
      // EVENTOS
      // =========================================================

      document.addEventListener(
        'DOMContentLoaded',
        async () => {

          console.log(
            'Copa Artemis 2026 iniciada.'
          );


          // Inicializar Supabase
          initializeSupabase();


          // Cargar jugadores
          await loadPlayerCount();


          // Countdown
          updateCountdown();

          setInterval(
            updateCountdown,
            1000
          );


          // -----------------------------------------------------
          // MODAL REGISTRO
          // -----------------------------------------------------

          $('registerBtn')
            ?.addEventListener(
              'click',
              () => {

                openModal(
                  $('registerModal')
                );

              }
            );


          $('closeRegister')
            ?.addEventListener(
              'click',
              () => {

                closeModal(
                  $('registerModal')
                );

              }
            );


          // -----------------------------------------------------
          // MODAL REGLAS
          // -----------------------------------------------------

          $('rulesBtn')
            ?.addEventListener(
              'click',
              () => {

                openModal(
                  $('rulesModal')
                );

              }
            );


          $('closeRules')
            ?.addEventListener(
              'click',
              () => {

                closeModal(
                  $('rulesModal')
                );

              }
            );


          // -----------------------------------------------------
          // MODAL CLASIFICACIÓN
          // -----------------------------------------------------

          const openLeaderboard =
            async () => {

              openModal(
                $('leaderboardModal')
              );

              await loadLeaderboard();
            };


          $('leaderboardBtn')
            ?.addEventListener(
              'click',
              openLeaderboard
            );


          $('heroLeaderboardBtn')
            ?.addEventListener(
              'click',
              openLeaderboard
            );


          $('closeLeaderboard')
            ?.addEventListener(
              'click',
              () => {

                closeModal(
                  $('leaderboardModal')
                );

              }
            );


          // -----------------------------------------------------
          // FORMULARIO
          // -----------------------------------------------------

          $('registerForm')
            ?.addEventListener(
              'submit',
              registerTrainer
            );


          // -----------------------------------------------------
          // CERRAR MODALES AL HACER CLICK AFUERA
          // -----------------------------------------------------

          document
            .querySelectorAll('.modal')
            .forEach(modal => {

              modal.addEventListener(
                'click',
                event => {

                  if (
                    event.target === modal
                  ) {

                    closeModal(
                      modal
                    );
                  }

                }
              );

            });


          // -----------------------------------------------------
          // ESCAPE
          // -----------------------------------------------------

          document.addEventListener(
            'keydown',
            event => {

              if (
                event.key !== 'Escape'
              ) {
                return;
              }


              document
                .querySelectorAll(
                  '.modal.active'
                )
                .forEach(modal => {

                  closeModal(
                    modal
                  );

                });

            }
          );

        }
      );
    </script>
  </body>
</html>