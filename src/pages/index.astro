    <!-- JAVASCRIPT -->
    <script>
        // ========== CONFIGURACIÓN SUPABASE ==========
        const SUPABASE_URL = 'https://flldgvplxxogaqdmvhkb.supabase.co';

        const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZsbGRndnBseHhvZ2FxZG12aGtiIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTIyMTY0ODksImV4cCI6MjEwNzc5MjQ4OX0.mmBIPpVvp0pmfIZTnEBRGN74fCYnfdPMs4Uym9Y8h30';

        const $ = id => document.getElementById(id);

        let supabaseClient = null;

        function initializeSupabase() {
            if (!window.supabase || !window.supabase.createClient) {
                console.error('No se pudo cargar Supabase.');
                return false;
            }

            if (!supabaseClient) {
                supabaseClient = window.supabase.createClient(
                    SUPABASE_URL,
                    SUPABASE_ANON_KEY
                );
            }

            return true;
        }

        // ========== NOTIFICACIONES ==========
        function toast(message, type = 'success') {
            $('toast-text').textContent = message;

            $('toast-body').className =
                'px-4 py-3 rounded-xl border bg-slate-900 text-slate-100 shadow-2xl ' +
                (type === 'error' ? 'border-rose-500' : 'border-slate-500');

            $('toast-container').classList.remove('hidden');

            clearTimeout(window.__toastT);

            window.__toastT = setTimeout(() => {
                $('toast-container').classList.add('hidden');
            }, 3500);
        }

        // ========== MODALES ==========
        function openModal(id) {
            $(id).classList.remove('hidden');
            $(id).classList.add('flex');
        }

        function closeModal(id) {
            $(id).classList.add('hidden');
            $(id).classList.remove('flex');
        }

        document.querySelectorAll('.close-modal').forEach(button => {
            button.addEventListener('click', () => {
                ['modal-register', 'modal-rules', 'modal-leaderboard']
                    .forEach(closeModal);
            });
        });

        ['modal-register', 'modal-rules', 'modal-leaderboard'].forEach(id => {
            $(id).addEventListener('click', event => {
                if (event.target.id === id) closeModal(id);
            });
        });

        document.addEventListener('keydown', event => {
            if (event.key === 'Escape') {
                ['modal-register', 'modal-rules', 'modal-leaderboard']
                    .forEach(closeModal);
            }
        });

        $('btn-open-register').addEventListener('click', () => openModal('modal-register'));
        $('btn-open-rules').addEventListener('click', () => openModal('modal-rules'));

        $('btn-leaderboard').addEventListener('click', async () => {
            openModal('modal-leaderboard');
            await loadLeaderboard();
        });

        // ========== CONTADOR ==========
        const target = new Date('2026-10-10T16:00:00-06:00').getTime();

        function updateCountdown() {
            const diff = target - Date.now();

            if (diff <= 0) {
                $('t-days').textContent = '00';
                $('t-hours').textContent = '00';
                $('t-minutes').textContent = '00';
                $('t-seconds').textContent = '00';
                return;
            }

            $('t-days').textContent = String(Math.floor(diff / 86400000)).padStart(2, '0');
            $('t-hours').textContent = String(Math.floor((diff % 86400000) / 3600000)).padStart(2, '0');
            $('t-minutes').textContent = String(Math.floor((diff % 3600000) / 60000)).padStart(2, '0');
            $('t-seconds').textContent = String(Math.floor((diff % 60000) / 1000)).padStart(2, '0');
        }

        updateCountdown();
        setInterval(updateCountdown, 1000);

        // ========== BOTÓN DE AUDIO ==========
        // Solo alterna iconos; todavía no hay música conectada.
        let audioOn = true;

        $('btn-audio').addEventListener('click', () => {
            audioOn = !audioOn;
            $('icon-vol-on').classList.toggle('hidden', !audioOn);
            $('icon-vol-off').classList.toggle('hidden', audioOn);
        });

        // ========== COMPARTIR ==========
        $('btn-share').addEventListener('click', async () => {
            try {
                if (navigator.share) {
                    await navigator.share({
                        title: document.title,
                        url: location.href
                    });
                } else {
                    await navigator.clipboard.writeText(location.href);
                    toast('¡Enlace copiado!');
                }
            } catch (error) {
                if (error.name !== 'AbortError') {
                    toast('No se pudo compartir el enlace.', 'error');
                }
            }
        });

        // ========== REGISTRO ==========
        $('form-register').addEventListener('submit', async event => {
            event.preventDefault();

            const nick = $('reg-nick').value.trim();
            const discord = $('reg-discord').value.trim();
            const accepted = $('reg-rules').checked;

            if (!nick || !discord) {
                toast('Completa todos los campos.', 'error');
                return;
            }

            if (!accepted) {
                toast('Debes aceptar el reglamento.', 'error');
                return;
            }

            if (!initializeSupabase()) {
                toast('No se pudo inicializar Supabase.', 'error');
                return;
            }

            const button = $('form-register').querySelector('[type="submit"]');
            button.disabled = true;
            button.textContent = 'Registrando...';

            try {
                const { data: trainer, error: trainerError } =
                    await supabaseClient
                        .from('entrenadores')
                        .insert([{ nickname: nick, discord: discord }])
                        .select()
                        .single();

                if (trainerError) throw trainerError;

                const { error: progressError } =
                    await supabaseClient
                        .from('progreso')
                        .insert([{
                            entrenador_id: trainer.id,
                            capturas: 0,
                            pokedex_total: 200
                        }]);

                if (progressError) {
                    console.error(progressError);
                    toast('Entrenador creado, pero falló su progreso inicial.', 'error');
                    await loadLeaderboard();
                    return;
                }

                toast('¡Inscripción confirmada! Bienvenido, ' + nick + ' 🏆');
                $('form-register').reset();
                closeModal('modal-register');

                await loadLeaderboard();

            } catch (error) {
                console.error('Error al registrar:', error);
                toast('Error al registrar. Revisa la configuración de Supabase.', 'error');
            } finally {
                button.disabled = false;
                button.textContent = 'Confirmar inscripción';
            }
        });

        // ========== LEADERBOARD ==========
        async function loadLeaderboard() {
            const list = $('leaderboard-list');

            if (!initializeSupabase()) {
                list.textContent = 'No se pudo conectar con Supabase.';
                return;
            }

            list.textContent = 'Cargando entrenadores...';

            try {
                const { data, error } = await supabaseClient
                    .from('entrenadores')
                    .select('*, progreso(capturas, pokedex_total)')
                    .order('created_at', { ascending: true });

                if (error) throw error;

                $('player-count').textContent = data.length;
                list.replaceChildren();

                if (data.length === 0) {
                    list.textContent = 'Aún no hay entrenadores registrados.';
                    return;
                }

                const sorted = [...data].sort((a, b) =>
                    (b.progreso?.[0]?.capturas || 0) -
                    (a.progreso?.[0]?.capturas || 0)
                );

                sorted.forEach((trainer, index) => {
                    const progress = trainer.progreso?.[0];
                    const captures = progress?.capturas || 0;
                    const total = progress?.pokedex_total || 200;

                    const row = document.createElement('div');
                    row.className = 'flex items-center gap-3 p-3 rounded-xl bg-slate-950/60 border border-slate-800';

                    const position = document.createElement('span');
                    position.className = 'w-7 text-center font-black text-amber-400';
                    position.textContent = String(index + 1);

                    const avatar = document.createElement('span');
                    avatar.className = 'text-lg';
                    avatar.textContent = trainer.avatar || '🎮';

                    const info = document.createElement('div');
                    info.className = 'flex-1 min-w-0';

                    const nickname = document.createElement('p');
                    nickname.className = 'text-sm font-bold text-slate-100 truncate';
                    nickname.textContent = trainer.nickname;

                    const region = document.createElement('p');
                    region.className = 'text-[11px] text-slate-400';
                    region.textContent = trainer.region || 'Ketzal Alpha';

                    const count = document.createElement('span');
                    count.className = 'text-xs font-black text-emerald-400';
                    count.textContent = `${captures}/${total}`;

                    info.append(nickname, region);
                    row.append(position, avatar, info, count);
                    list.appendChild(row);
                });

            } catch (error) {
                console.error('Error al cargar leaderboard:', error);
                list.textContent = 'No se pudo cargar el leaderboard. Revisa las tablas y las políticas RLS.';
            }
        }

        // ========== INICIO ==========
        loadLeaderboard();
    </script>
</body>
</html>
