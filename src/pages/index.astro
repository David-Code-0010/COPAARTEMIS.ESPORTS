---
const title = "Copa Artemis 2026";
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>

  <!-- =========================================================
       SUPABASE CDN
       ========================================================= -->
  <script
    is:inline
    src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js"
  ></script>

  <style>
    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: Arial, Helvetica, sans-serif;
      background:
        radial-gradient(circle at top, #3a3a3a 0%, #151515 42%, #070707 100%);
      color: white;
    }

    button,
    input {
      font: inherit;
    }

    button {
      cursor: pointer;
    }

    .page {
      width: 100%;
      min-height: 100vh;
      padding: 20px;
    }

    .silver-frame {
      max-width: 1450px;
      margin: 0 auto;
      min-height: calc(100vh - 40px);
      border: 3px solid #bdbdbd;
      border-radius: 24px;
      padding: 4px;
      background: linear-gradient(
        135deg,
        #eeeeee,
        #6e6e6e,
        #dcdcdc,
        #555,
        #eeeeee
      );
      box-shadow:
        0 0 0 2px #222,
        0 20px 70px rgba(0, 0, 0, 0.65);
    }

    .main-panel {
      min-height: calc(100vh - 54px);
      border-radius: 18px;
      overflow: hidden;
      background:
        radial-gradient(circle at 50% 0%, #242424 0%, #101010 48%, #080808 100%);
    }

    /* =========================================================
       HEADER
       ========================================================= */

    header {
      height: 76px;
      padding: 0 30px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid rgba(255,255,255,0.08);
      background: rgba(8, 8, 8, 0.9);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      font-weight: 900;
      letter-spacing: 1px;
    }

    .brand img {
      width: 42px;
      height: 42px;
      object-fit: cover;
      border-radius: 10px;
      border: 2px solid #fff;
    }

    .brand-text {
      font-size: 16px;
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .player-count,
    .nav-button {
      border: 1px solid rgba(255,255,255,0.14);
      background: rgba(255,255,255,0.05);
      color: white;
      border-radius: 999px;
      padding: 10px 15px;
      font-weight: 800;
    }

    .nav-button:hover {
      background: rgba(255,255,255,0.1);
    }

    /* =========================================================
       HERO
       ========================================================= */

    main {
      padding: 45px 30px 70px;
    }

    .hero {
      text-align: center;
      max-width: 1050px;
      margin: 0 auto;
    }

    .pill {
      display: inline-block;
      padding: 8px 18px;
      border: 1px solid rgba(255,255,255,0.25);
      border-radius: 999px;
      background: rgba(255,255,255,0.06);
      font-weight: 900;
      letter-spacing: 2px;
      font-size: 12px;
    }

    .hero h1 {
      margin: 20px 0 5px;
      font-size: clamp(48px, 8vw, 100px);
      line-height: 0.95;
      font-weight: 1000;
      letter-spacing: -4px;
      text-transform: uppercase;
    }

    .hero h2 {
      margin: 0;
      font-size: clamp(20px, 4vw, 34px);
      color: #bcbcbc;
      font-weight: 900;
      letter-spacing: 3px;
    }

    .hero-tagline {
      margin-top: 20px;
      font-size: 17px;
      font-weight: 800;
      color: #e4e4e4;
    }

    .hero-description {
      max-width: 760px;
      margin: 15px auto 0;
      line-height: 1.7;
      color: #999;
      font-size: 15px;
    }

    /* =========================================================
       COUNTDOWN
       ========================================================= */

    .countdown-card {
      max-width: 900px;
      margin: 38px auto 0;
      padding: 28px;
      border-radius: 20px;
      border: 1px solid rgba(255,255,255,0.14);
      background:
        linear-gradient(
          145deg,
          rgba(255,255,255,0.08),
          rgba(255,255,255,0.025)
        );
      box-shadow: 0 20px 50px rgba(0,0,0,0.35);
    }

    .countdown-title {
      font-size: 13px;
      letter-spacing: 3px;
      color: #aaa;
      font-weight: 900;
    }

    .countdown {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
      margin-top: 20px;
    }

    .time-box {
      padding: 20px 10px;
      border-radius: 15px;
      background: rgba(0,0,0,0.35);
      border: 1px solid rgba(255,255,255,0.08);
    }

    .time-number {
      display: block;
      font-size: clamp(28px, 5vw, 48px);
      font-weight: 1000;
      line-height: 1;
    }

    .time-label {
      display: block;
      margin-top: 8px;
      font-size: 10px;
      letter-spacing: 2px;
      color: #777;
      font-weight: 900;
    }

    .countdown-status {
      margin-top: 15px;
      font-size: 12px;
      color: #999;
      font-weight: 800;
      letter-spacing: 1px;
    }

    /* =========================================================
       FEATURES
       ========================================================= */

    .features {
      max-width: 1150px;
      margin: 55px auto 0;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }

    .feature-card {
      overflow: hidden;
      border-radius: 18px;
      border: 1px solid rgba(255,255,255,0.12);
      background: rgba(255,255,255,0.035);
    }

    .feature-card img {
      width: 100%;
      height: 210px;
      display: block;
      object-fit: cover;
    }

    .feature-content {
      padding: 20px;
    }

    .feature-content h3 {
      margin: 0 0 8px;
      font-size: 20px;
      font-weight: 1000;
    }

    .feature-content p {
      margin: 0;
      color: #888;
      line-height: 1.6;
      font-size: 14px;
    }

    /* =========================================================
       BUTTONS
       ========================================================= */

    .action-row {
      margin-top: 40px;
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 12px;
    }

    .primary-button,
    .secondary-button {
      border-radius: 12px;
      padding: 14px 22px;
      border: 1px solid rgba(255,255,255,0.2);
      font-weight: 900;
      transition: 0.2s ease;
    }

    .primary-button {
      background: white;
      color: #080808;
    }

    .secondary-button {
      background: rgba(255,255,255,0.06);
      color: white;
    }

    .primary-button:hover,
    .secondary-button:hover {
      transform: translateY(-2px);
    }

    /* =========================================================
       DETAILS
       ========================================================= */

    .details {
      max-width: 1150px;
      margin: 70px auto 0;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }

    .detail-card {
      overflow: hidden;
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 18px;
      background: rgba(255,255,255,0.035);
    }

    .detail-card img {
      width: 100%;
      height: 250px;
      object-fit: cover;
      display: block;
    }

    .detail-content {
      padding: 22px;
    }

    .detail-content h3 {
      margin: 0 0 10px;
      font-size: 22px;
    }

    .detail-content p {
      color: #999;
      line-height: 1.7;
      margin: 0;
    }

    /* =========================================================
       MODALS
       ========================================================= */

    .modal {
      position: fixed;
      inset: 0;
      z-index: 1000;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
      background: rgba(0,0,0,0.78);
      backdrop-filter: blur(10px);
    }

    .modal.open {
      display: flex;
    }

    .modal-box {
      width: min(650px, 100%);
      max-height: 90vh;
      overflow-y: auto;
      padding: 28px;
      border-radius: 20px;
      border: 1px solid rgba(255,255,255,0.16);
      background:
        linear-gradient(145deg, #1d1d1d, #090909);
      box-shadow: 0 30px 100px rgba(0,0,0,0.75);
    }

    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
      margin-bottom: 25px;
    }

    .modal-header h2 {
      margin: 0;
      font-size: 25px;
    }

    .close-modal {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      border: 1px solid rgba(255,255,255,0.15);
      background: rgba(255,255,255,0.05);
      color: white;
      font-size: 20px;
    }

    .form-group {
      margin-bottom: 18px;
    }

    .form-group label {
      display: block;
      margin-bottom: 8px;
      color: #aaa;
      font-size: 12px;
      font-weight: 900;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .form-group input {
      width: 100%;
      padding: 14px;
      border-radius: 10px;
      border: 1px solid rgba(255,255,255,0.13);
      background: rgba(255,255,255,0.05);
      color: white;
      outline: none;
    }

    .form-group input:focus {
      border-color: rgba(255,255,255,0.4);
    }

    .checkbox-row {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      color: #aaa;
      font-size: 13px;
      line-height: 1.5;
      margin: 20px 0;
    }

    .checkbox-row input {
      margin-top: 3px;
    }

    .form-status {
      min-height: 20px;
      margin-top: 15px;
      font-size: 13px;
      color: #aaa;
    }

    /* =========================================================
       LEADERBOARD
       ========================================================= */

    .leaderboard-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .leaderboard-row {
      display: grid;
      grid-template-columns: 45px 1fr auto;
      align-items: center;
      gap: 12px;
      padding: 14px;
      border-radius: 12px;
      border: 1px solid rgba(255,255,255,0.08);
      background: rgba(255,255,255,0.035);
    }

    .leaderboard-position {
      font-size: 18px;
      font-weight: 1000;
      color: #777;
      text-align: center;
    }

    .leaderboard-name {
      font-weight: 900;
    }

    .leaderboard-region {
      margin-top: 4px;
      color: #777;
      font-size: 11px;
    }

    .leaderboard-count {
      font-weight: 1000;
      white-space: nowrap;
    }

    .list-status {
      padding: 20px;
      text-align: center;
      color: #888;
    }

    /* =========================================================
       RULES
       ========================================================= */

    .rules-content {
      color: #aaa;
      line-height: 1.7;
      font-size: 14px;
    }

    .rules-content h3 {
      color: white;
      margin-top: 22px;
      margin-bottom: 8px;
    }

    .rules-content ul {
      padding-left: 20px;
    }

    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @media (max-width: 850px) {
      .features {
        grid-template-columns: 1fr;
      }

      .details {
        grid-template-columns: 1fr;
      }

      header {
        padding: 0 15px;
      }

      .brand-text {
        display: none;
      }
    }

    @media (max-width: 600px) {
      .page {
        padding: 8px;
      }

      .silver-frame {
        min-height: calc(100vh - 16px);
      }

      main {
        padding: 35px 15px 50px;
      }

      .countdown {
        gap: 6px;
      }

      .time-box {
        padding: 15px 5px;
      }

      .time-label {
        font-size: 8px;
        letter-spacing: 1px;
      }

      .nav-actions {
        gap: 5px;
      }

      .player-count,
      .nav-button {
        padding: 8px 10px;
        font-size: 11px;
      }
    }
  </style>
</head>

<body>
  <div class="page">
    <div class="silver-frame">
      <div class="main-panel">

        <!-- =====================================================
             HEADER
             ===================================================== -->

        <header>
          <div class="brand">
            <img
              src="https://files.catbox.moe/0naii0.jpg"
              alt="Copa Artemis"
            />

            <div class="brand-text">
              COPA ARTEMIS 2026
            </div>
          </div>

          <div class="nav-actions">
            <div class="player-count" id="player-count">
              0 ENTRENADORES
            </div>

            <button class="nav-button" id="share-button">
              COMPARTIR
            </button>

            <button class="nav-button" id="audio-button">
              🔊
            </button>
          </div>
        </header>

        <!-- =====================================================
             MAIN
             ===================================================== -->

        <main>

          <section class="hero">

            <span class="pill">
              COPA ARTEMIS
            </span>

            <h1>
              CONCURSO ARTEMIS
            </h1>

            <h2>
              x CURI GAMEPLAYS
            </h2>

            <div class="hero-tagline">
              EL DESAFÍO DEFINITIVO PARA ENTRENADORES
            </div>

            <p class="hero-description">
              Prepárate para competir, demostrar tus habilidades y convertirte
              en uno de los mejores entrenadores de la Copa Artemis 2026.
            </p>

            <!-- =================================================
                 COUNTDOWN
                 ================================================= -->

            <div class="countdown-card">

              <div class="countdown-title" id="countdown-title">
                TIEMPO RESTANTE
              </div>

              <div class="countdown">

                <div class="time-box">
                  <span class="time-number" id="days">
                    00
                  </span>

                  <span class="time-label">
                    DÍAS
                  </span>
                </div>

                <div class="time-box">
                  <span class="time-number" id="hours">
                    00
                  </span>

                  <span class="time-label">
                    HORAS
                  </span>
                </div>

                <div class="time-box">
                  <span class="time-number" id="minutes">
                    00
                  </span>

                  <span class="time-label">
                    MINUTOS
                  </span>
                </div>

                <div class="time-box">
                  <span class="time-number" id="seconds">
                    00
                  </span>

                  <span class="time-label">
                    SEGUNDOS
                  </span>
                </div>

              </div>

              <div class="countdown-status" id="countdown-status">
                HORA MÉXICO
              </div>

            </div>

          </section>

          <!-- ===================================================
               FEATURES
               =================================================== -->

          <section class="features">

            <article class="feature-card">

              <img
                src="https://files.catbox.moe/ptoku8.jpg"
                alt="Competencia"
              />

              <div class="feature-content">

                <h3>
                  COMPITE
                </h3>

                <p>
                  Enfréntate al desafío y demuestra todo lo que puedes lograr
                  como entrenador.
                </p>

              </div>

            </article>

            <article class="feature-card">

              <img
                src="https://files.catbox.moe/1iilzg.jpg"
                alt="Entrenadores"
              />

              <div class="feature-content">

                <h3>
                  SUPERA EL RETO
                </h3>

                <p>
                  Completa tus objetivos y avanza en la clasificación de la
                  Copa Artemis.
                </p>

              </div>

            </article>

            <article class="feature-card">

              <img
                src="https://files.catbox.moe/an6jpo.jpg"
                alt="Pokémon"
              />

              <div class="feature-content">

                <h3>
                  CONQUISTA LA COPA
                </h3>

                <p>
                  Sube al leaderboard y demuestra que eres uno de los mejores.
                </p>

              </div>

            </article>

          </section>

          <!-- ===================================================
               ACTION BUTTONS
               =================================================== -->

          <div class="action-row">

            <button
              class="primary-button"
              id="open-register"
            >
              INSCRIBIRME
            </button>

            <button
              class="secondary-button"
              id="open-rules"
            >
              VER REGLAS
            </button>

            <button
              class="secondary-button"
              id="open-leaderboard"
            >
              LEADERBOARD
            </button>

          </div>

          <!-- ===================================================
               DETAILS
               =================================================== -->

          <section class="details">

            <article class="detail-card">

              <img
                src="https://files.catbox.moe/omht9x.jpg"
                alt="Información de la Copa Artemis"
              />

              <div class="detail-content">

                <h3>
                  INFORMACIÓN DEL EVENTO
                </h3>

                <p>
                  La Copa Artemis 2026 reúne a entrenadores para competir,
                  avanzar y demostrar sus habilidades durante el evento.
                </p>

              </div>

            </article>

            <article class="detail-card">

              <img
                src="https://files.catbox.moe/lniiri.jpg"
                alt="Discord Copa Artemis"
              />

              <div class="detail-content">

                <h3>
                  ÚNETE AL DISCORD
                </h3>

                <p>
                  Mantente informado, recibe anuncios y participa junto a
                  los demás entrenadores de la Copa Artemis.
                </p>

                <div style="margin-top:18px;">
                  <a
                    class="secondary-button"
                    href="https://discord.gg/3GWTVzjHS4"
                    target="_blank"
                    rel="noopener noreferrer"
                    style="display:inline-block;text-decoration:none;"
                  >
                    ENTRAR AL DISCORD
                  </a>
                </div>

              </div>

            </article>

          </section>

        </main>

      </div>
    </div>
  </div>

  <!-- ===========================================================
       REGISTRATION MODAL
       =========================================================== -->

  <div
    class="modal"
    id="register-modal"
    aria-hidden="true"
  >

    <div class="modal-box">

      <div class="modal-header">

        <h2>
          INSCRIPCIÓN
        </h2>

        <button
          class="close-modal"
          data-close="register-modal"
        >
          ×
        </button>

      </div>

      <form id="registration-form">

        <div class="form-group">

          <label for="reg-nick">
            Nickname
          </label>

          <input
            id="reg-nick"
            type="text"
            maxlength="30"
            required
            placeholder="Tu nickname"
          />

        </div>

        <div class="form-group">

          <label for="reg-discord">
            Discord
          </label>

          <input
            id="reg-discord"
            type="text"
            maxlength="50"
            required
            placeholder="Tu usuario de Discord"
          />

        </div>

        <label class="checkbox-row">

          <input
            id="reg-rules"
            type="checkbox"
            required
          />

          <span>
            Confirmo que he leído y acepto las reglas de la Copa Artemis.
          </span>

        </label>

        <button
          class="primary-button"
          type="submit"
          style="width:100%;"
          id="submit-registration"
        >
          CONFIRMAR INSCRIPCIÓN
        </button>

        <div
          class="form-status"
          id="registration-status"
        ></div>

      </form>

    </div>

  </div>

  <!-- ===========================================================
       RULES MODAL
       =========================================================== -->

  <div
    class="modal"
    id="rules-modal"
    aria-hidden="true"
  >

    <div class="modal-box">

      <div class="modal-header">

        <h2>
          REGLAS
        </h2>

        <button
          class="close-modal"
          data-close="rules-modal"
        >
          ×
        </button>

      </div>

      <div class="rules-content">

        <h3>
          1. RESPETO
        </h3>

        <p>
          Todos los participantes deben mantener un comportamiento respetuoso
          con los demás participantes y organizadores.
        </p>

        <h3>
          2. PARTICIPACIÓN
        </h3>

        <p>
          Cada entrenador deberá participar utilizando la información
          proporcionada durante su inscripción.
        </p>

        <h3>
          3. RESULTADOS
        </h3>

        <p>
          Los resultados y progreso registrados durante la competencia serán
          utilizados para determinar la clasificación.
        </p>

        <h3>
          4. DEScalificación
        </h3>

        <p>
          El incumplimiento de las reglas puede provocar la descalificación
          del participante.
        </p>

        <h3>
          5. DECISIONES
        </h3>

        <p>
          Las decisiones de la organización respecto a la competencia serán
          definitivas.
        </p>

      </div>

    </div>

  </div>

  <!-- ===========================================================
       LEADERBOARD MODAL
       =========================================================== -->

  <div
    class="modal"
    id="leaderboard-modal"
    aria-hidden="true"
  >

    <div class="modal-box">

      <div class="modal-header">

        <h2>
          LEADERBOARD
        </h2>

        <button
          class="close-modal"
          data-close="leaderboard-modal"
        >
          ×
        </button>

      </div>

      <div
        class="list-status"
        id="leaderboard-status"
      >
        Conectando con la base de datos...
      </div>

      <div
        class="leaderboard-list"
        id="leaderboard-list"
      ></div>

    </div>

  </div>

  <!-- ===========================================================
       JAVASCRIPT
       =========================================================== -->

  <script is:inline>
    /* =========================================================
       SUPABASE
       ========================================================= */

    const SUPABASE_URL =
      'https://flldgvplxxogaqdmvhkb.supabase.co';

    const SUPABASE_PUBLISHABLE_KEY =
      'sb_publishable_xak3DICWNkTS2ibbeeixLg_9vEcgDjc';

    let supabaseClient = null;

    function initializeSupabase() {
      try {
        if (
          !window.supabase ||
          typeof window.supabase.createClient !== 'function'
        ) {
          console.error(
            '[Supabase] El CDN no se cargó correctamente.'
          );

          return false;
        }

        if (!supabaseClient) {
          supabaseClient = window.supabase.createClient(
            SUPABASE_URL,
            SUPABASE_PUBLISHABLE_KEY
          );
        }

        return true;

      } catch (error) {

        console.error(
          '[Supabase] Error inicializando:',
          error
        );

        return false;
      }
    }

    console.info(
      '[Supabase] CDN cargado:',
      !!window.supabase
    );

    /* =========================================================
       ERROR HANDLER
       ========================================================= */

    function getFriendlyError(error) {

      if (!error) {
        return 'Ocurrió un error desconocido.';
      }

      console.error(
        '[Supabase ERROR]',
        error
      );

      const message =
        error.message ||
        error.details ||
        error.hint ||
        String(error);

      if (
        message.includes(
          'entrenadores_status_check'
        )
      ) {
        return (
          'El estado enviado no es válido. ' +
          'Los estados permitidos son: Inscrito, En Carrera o Descalificado.'
        );
      }

      if (
        message.includes(
          'trainer_id'
        ) ||
        message.includes(
          'pokemon_caught'
        ) ||
        message.includes(
          'total_pokedex'
        )
      ) {
        return (
          'La estructura de la tabla progreso no coincide con la consulta.'
        );
      }

      if (
        message.toLowerCase().includes(
          'row-level security'
        ) ||
        message.toLowerCase().includes(
          'permission denied'
        )
      ) {
        return (
          'Supabase está conectado, pero las políticas RLS no permiten esta operación.'
        );
      }

      if (
        message.toLowerCase().includes(
          'failed to fetch'
        )
      ) {
        return (
          'No se pudo realizar la petición a Supabase. Revisa la conexión.'
        );
      }

      return message;
    }

    /* =========================================================
       ELEMENTS
       ========================================================= */

    const registerModal =
      document.getElementById(
        'register-modal'
      );

    const rulesModal =
      document.getElementById(
        'rules-modal'
      );

    const leaderboardModal =
      document.getElementById(
        'leaderboard-modal'
      );

    const registrationForm =
      document.getElementById(
        'registration-form'
      );

    const registrationStatus =
      document.getElementById(
        'registration-status'
      );

    const submitRegistration =
      document.getElementById(
        'submit-registration'
      );

    const leaderboardList =
      document.getElementById(
        'leaderboard-list'
      );

    const leaderboardStatus =
      document.getElementById(
        'leaderboard-status'
      );

    const playerCount =
      document.getElementById(
        'player-count'
      );

    /* =========================================================
       MODALS
       ========================================================= */

    function openModal(modal) {

      if (!modal) {
        return;
      }

      modal.classList.add('open');
      modal.setAttribute(
        'aria-hidden',
        'false'
      );
    }

    function closeModal(modal) {

      if (!modal) {
        return;
      }

      modal.classList.remove('open');
      modal.setAttribute(
        'aria-hidden',
        'true'
      );
    }

    document
      .getElementById('open-register')
      ?.addEventListener(
        'click',
        () => openModal(registerModal)
      );

    document
      .getElementById('open-rules')
      ?.addEventListener(
        'click',
        () => openModal(rulesModal)
      );

    document
      .getElementById('open-leaderboard')
      ?.addEventListener(
        'click',
        async () => {

          openModal(
            leaderboardModal
          );

          await loadLeaderboard();
        }
      );

    document
      .querySelectorAll('[data-close]')
      .forEach(button => {

        button.addEventListener(
          'click',
          () => {

            const modalId =
              button.dataset.close;

            closeModal(
              document.getElementById(
                modalId
              )
            );
          }
        );
      });

    [
      registerModal,
      rulesModal,
      leaderboardModal
    ].forEach(modal => {

      modal?.addEventListener(
        'click',
        event => {

          if (
            event.target === modal
          ) {
            closeModal(modal);
          }
        }
      );
    });

    document.addEventListener(
      'keydown',
      event => {

        if (event.key === 'Escape') {

          closeModal(registerModal);
          closeModal(rulesModal);
          closeModal(leaderboardModal);
        }
      }
    );

    /* =========================================================
       COUNTDOWN - HORA MÉXICO
       ========================================================= */

    const tournamentStart =
      new Date(
        '2026-10-10T16:00:00-06:00'
      ).getTime();

    const tournamentEnd =
      new Date(
        '2026-10-25T23:59:59-06:00'
      ).getTime();

    function updateCountdown() {

      const now =
        Date.now();

      const days =
        document.getElementById(
          'days'
        );

      const hours =
        document.getElementById(
          'hours'
        );

      const minutes =
        document.getElementById(
          'minutes'
        );

      const seconds =
        document.getElementById(
          'seconds'
        );

      const title =
        document.getElementById(
          'countdown-title'
        );

      const status =
        document.getElementById(
          'countdown-status'
        );

      let difference = 0;

      if (now < tournamentStart) {

        difference =
          tournamentStart - now;

        title.textContent =
          'TIEMPO PARA EL INICIO';

        status.textContent =
          '10 OCT, 2026 · 16:00 HORA MÉXICO';

      } else if (now < tournamentEnd) {

        difference =
          tournamentEnd - now;

        title.textContent =
          'TIEMPO RESTANTE';

        status.textContent =
          '25 OCT, 2026 · 23:59 HORA MÉXICO';

      } else {

        difference = 0;

        title.textContent =
          'TORNEO FINALIZADO';

        status.textContent =
          'LA COPA ARTEMIS 2026 HA TERMINADO';
      }

      const totalSeconds =
        Math.max(
          0,
          Math.floor(
            difference / 1000
          )
        );

      const d =
        Math.floor(
          totalSeconds / 86400
        );

      const h =
        Math.floor(
          (totalSeconds % 86400) / 3600
        );

      const m =
        Math.floor(
          (totalSeconds % 3600) / 60
        );

      const s =
        totalSeconds % 60;

      days.textContent =
        String(d).padStart(2, '0');

      hours.textContent =
        String(h).padStart(2, '0');

      minutes.textContent =
        String(m).padStart(2, '0');

      seconds.textContent =
        String(s).padStart(2, '0');
    }

    updateCountdown();

    setInterval(
      updateCountdown,
      1000
    );

    /* =========================================================
       LOAD PLAYER COUNT
       ========================================================= */

    async function loadPlayerCount() {

      if (!initializeSupabase()) {
        return;
      }

      try {

        const {
          count,
          error
        } = await supabaseClient
          .from('entrenadores')
          .select(
            'id',
            {
              count: 'exact',
              head: true
            }
          );

        if (error) {
          throw error;
        }

        playerCount.textContent =
          `${count || 0} ENTRENADORES`;

      } catch (error) {

        console.error(
          '[Supabase] Error contando entrenadores:',
          error
        );

        playerCount.textContent =
          '0 ENTRENADORES';
      }
    }

    /* =========================================================
       REGISTRATION
       ========================================================= */

    registrationForm?.addEventListener(
      'submit',
      async event => {

        event.preventDefault();

        if (!initializeSupabase()) {

          registrationStatus.textContent =
            'No se pudo cargar Supabase. Recarga la página.';

          return;
        }

        const nick =
          document
            .getElementById('reg-nick')
            .value
            .trim();

        const discord =
          document
            .getElementById('reg-discord')
            .value
            .trim();

        const accepted =
          document
            .getElementById('reg-rules')
            .checked;

        if (!nick) {

          registrationStatus.textContent =
            'Introduce tu nickname.';

          return;
        }

        if (!discord) {

          registrationStatus.textContent =
            'Introduce tu usuario de Discord.';

          return;
        }

        if (!accepted) {

          registrationStatus.textContent =
            'Debes aceptar las reglas.';

          return;
        }

        submitRegistration.disabled =
          true;

        submitRegistration.textContent =
          'REGISTRANDO...';

        registrationStatus.textContent =
          'Guardando tu inscripción...';

        try {

          /* -----------------------------------------------
             1. CREAR ENTRENADOR
             ----------------------------------------------- */

          const {
            data: trainer,
            error: trainerError
          } = await supabaseClient
            .from('entrenadores')
            .insert([
              {
                nickname: nick,

                discord_user: discord,

                region: 'Ketzal',

                status: 'Inscrito',

                accepted_rules: accepted,

                created_at:
                  new Date().toISOString()
              }
            ])
            .select(
              'id,nickname'
            )
            .single();

          if (trainerError) {
            throw trainerError;
          }

          if (!trainer?.id) {

            throw new Error(
              'Supabase no devolvió el ID del entrenador.'
            );
          }

          /* -----------------------------------------------
             2. CREAR PROGRESO
             ----------------------------------------------- */

          const {
            error: progressError
          } = await supabaseClient
            .from('progreso')
            .insert([
              {
                trainer_id:
                  trainer.id,

                pokemon_caught:
                  0,

                total_pokedex:
                  200,

                updated_at:
                  new Date().toISOString()
              }
            ]);

          if (progressError) {

            console.error(
              '[Supabase] Error creando progreso:',
              progressError
            );

            /*
             * Intentamos limpiar el entrenador creado
             * para no dejar una inscripción incompleta.
             */

            try {

              await supabaseClient
                .from('entrenadores')
                .delete()
                .eq(
                  'id',
                  trainer.id
                );

            } catch (cleanupError) {

              console.warn(
                '[Supabase] No se pudo limpiar el entrenador:',
                cleanupError
              );
            }

            throw progressError;
          }

          /* -----------------------------------------------
             3. ÉXITO
             ----------------------------------------------- */

          registrationStatus.textContent =
            '¡Inscripción completada correctamente!';

          registrationStatus.style.color =
            '#ffffff';

          registrationForm.reset();

          await loadPlayerCount();

          setTimeout(
            () => {

              closeModal(
                registerModal
              );

              registrationStatus.textContent =
                '';

              submitRegistration.disabled =
                false;

              submitRegistration.textContent =
                'CONFIRMAR INSCRIPCIÓN';

            },
            1800
          );

        } catch (error) {

          console.error(
            '[Supabase] Error de registro:',
            error
          );

          registrationStatus.textContent =
            getFriendlyError(error);

          registrationStatus.style.color =
            '#ff8080';

          submitRegistration.disabled =
            false;

          submitRegistration.textContent =
            'CONFIRMAR INSCRIPCIÓN';
        }
      }
    );

    /* =========================================================
       LEADERBOARD
       ========================================================= */

    let leaderboardLoading =
      false;

    function setListStatus(
      message
    ) {

      leaderboardStatus.textContent =
        message;
    }

    async function loadLeaderboard() {

      if (leaderboardLoading) {
        return;
      }

      if (!initializeSupabase()) {

        setListStatus(
          'No se pudo cargar Supabase.'
        );

        return;
      }

      leaderboardLoading =
        true;

      leaderboardList.innerHTML =
        '';

      setListStatus(
        'Conectando con la base de datos...'
      );

      try {

        /* -----------------------------------------------
           OBTENER ENTRENADORES
           ----------------------------------------------- */

        const {
          data: trainers,
          error: trainersError
        } = await supabaseClient
          .from('entrenadores')
          .select(
            'id,nickname,region,created_at'
          )
          .order(
            'created_at',
            {
              ascending: true
            }
          );

        if (trainersError) {
          throw trainersError;
        }

        const trainerRows =
          trainers || [];

        /* -----------------------------------------------
           OBTENER PROGRESO
           ----------------------------------------------- */

        let progressRows = [];

        if (
          trainerRows.length > 0
        ) {

          const trainerIds =
            trainerRows.map(
              trainer => trainer.id
            );

          const {
            data,
            error: progressError
          } = await supabaseClient
            .from('progreso')
            .select(
              'id,trainer_id,pokemon_caught,total_pokedex,updated_at'
            )
            .in(
              'trainer_id',
              trainerIds
            );

          if (progressError) {
            throw progressError;
          }

          progressRows =
            data || [];
        }

        /* -----------------------------------------------
           CREAR MAPA DE PROGRESO
           ----------------------------------------------- */

        const progressMap =
          new Map(
            progressRows.map(
              progress => [
                String(
                  progress.trainer_id
                ),
                progress
              ]
            )
          );

        /* -----------------------------------------------
           UNIR ENTRENADORES + PROGRESO
           ----------------------------------------------- */

        const combined =
          trainerRows.map(
            trainer => {

              const progress =
                progressMap.get(
                  String(trainer.id)
                ) || null;

              return {
                ...trainer,
                progress
              };
            }
          );

        /* -----------------------------------------------
           ORDENAR POR POKÉMON CAPTURADOS
           ----------------------------------------------- */

        combined.sort(
          (a, b) => {

            const capturesA =
              Number(
                a.progress?.pokemon_caught ??
                0
              );

            const capturesB =
              Number(
                b.progress?.pokemon_caught ??
                0
              );

            return (
              capturesB -
              capturesA
            );
          }
        );

        if (
          combined.length === 0
        ) {

          setListStatus(
            'Todavía no hay entrenadores registrados.'
          );

          return;
        }

        setListStatus(
          `${combined.length} entrenadores registrados`
        );

        /* -----------------------------------------------
           RENDER
           ----------------------------------------------- */

        combined.forEach(
          (trainer, index) => {

            const captures =
              Number(
                trainer.progress?.pokemon_caught ??
                0
              );

            const total =
              Number(
                trainer.progress?.total_pokedex ??
                200
              );

            const row =
              document.createElement(
                'div'
              );

            row.className =
              'leaderboard-row';

            const position =
              document.createElement(
                'div'
              );

            position.className =
              'leaderboard-position';

            position.textContent =
              `#${index + 1}`;

            const information =
              document.createElement(
                'div'
              );

            const name =
              document.createElement(
                'div'
              );

            name.className =
              'leaderboard-name';

            name.textContent =
              trainer.nickname ||
              'Sin nickname';

            const region =
              document.createElement(
                'div'
              );

            region.className =
              'leaderboard-region';

            region.textContent =
              trainer.region ||
              'Ketzal';

            information.appendChild(
              name
            );

            information.appendChild(
              region
            );

            const count =
              document.createElement(
                'div'
              );

            count.className =
              'leaderboard-count';

            count.textContent =
              `${captures}/${total}`;

            row.appendChild(
              position
            );

            row.appendChild(
              information
            );

            row.appendChild(
              count
            );

            leaderboardList.appendChild(
              row
            );
          }
        );

      } catch (error) {

        console.error(
          '[Supabase] Error cargando leaderboard:',
          error
        );

        setListStatus(
          getFriendlyError(error)
        );

      } finally {

        leaderboardLoading =
          false;
      }
    }

    /* =========================================================
       SHARE
       ========================================================= */

    document
      .getElementById('share-button')
      ?.addEventListener(
        'click',
        async () => {

          const shareData = {
            title:
              'Copa Artemis 2026',

            text:
              'Únete a la Copa Artemis 2026.',

            url:
              window.location.href
          };

          try {

            if (
              navigator.share
            ) {

              await navigator.share(
                shareData
              );

            } else if (
              navigator.clipboard
            ) {

              await navigator.clipboard.writeText(
                window.location.href
              );

              alert(
                'Enlace copiado al portapapeles.'
              );
            }

          } catch (error) {

            console.warn(
              'Compartir cancelado:',
              error
            );
          }
        }
      );

    /* =========================================================
       AUDIO
       ========================================================= */

    let audioEnabled =
      false;

    document
      .getElementById('audio-button')
      ?.addEventListener(
        'click',
        () => {

          audioEnabled =
            !audioEnabled;

          document
            .getElementById(
              'audio-button'
            )
            .textContent =
              audioEnabled
                ? '🔊'
                : '🔇';
        }
      );

    /* =========================================================
       INIT
       ========================================================= */

    window.addEventListener(
      'load',
      async () => {

        initializeSupabase();

        await loadPlayerCount();

      }
    );
  </script>
</body>
</html>