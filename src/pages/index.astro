    }

    .discord-icon {
        width: 12px;
        height: 12px;
    }

    /* FOOTER */
    .poster-footer {
        margin-top: 10px;
        font-size: 0.5rem;
        color: #64748b;
    }

    .website-link {
        color: #cbd5e1;
        text-decoration: none;
        font-weight: 700;
        display: block;
        margin-top: 2px;
    }

    /* MODAL */
    #register-form-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.85);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 100;
        backdrop-filter: blur(5px);
    }

    .hidden { display: none !important; }

    #register-form {
        background: var(--dark-bg);
        padding: 25px 20px;
        border: 2px solid var(--gold-primary);
        border-radius: 16px;
        width: 90%;
        max-width: 380px;
        display: flex;
        flex-direction: column;
        gap: 12px;
        box-shadow: 0 0 25px rgba(226, 168, 56, 0.3);
    }

    #register-form h3 {
        font-family: var(--font-header);
        color: var(--gold-primary);
        text-align: center;
        font-size: 1.1rem;
    }

    .form-subtext {
        text-align: center;
        font-size: 0.75rem;
        color: #94a3b8;
        margin-top: -8px;
