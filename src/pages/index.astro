---
// --- DATOS INICIALES (Renderizado en el Servidor) ---
const POKEMON_TYPES = [
  { name: 'Planta', icon: '<path d="M11 20A7 7 0 0 1 4 13v-5a2 2 0 0 1 2-2h5a7 7 0 0 1 7 7v5a2 2 0 0 1-2 2h-5Z"/><path d="M11 20V10"/>', color: 'from-emerald-400 to-green-600', glow: 'shadow-emerald-500/50' },
  { name: 'Fuego', icon: '<path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/>', color: 'from-amber-500 to-red-600', glow: 'shadow-red-500/50' },
  { name: 'Agua', icon: '<path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/>', color: 'from-cyan-400 to-blue-600', glow: 'shadow-cyan-500/50' },
  { name: 'Eléctrico', icon: '<path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/>', color: 'from-yellow-300 to-amber-500', glow: 'shadow-yellow-500/50' },
  { name: 'Psíquico', icon: '<path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/>', color: 'from-fuchsia-400 to-purple-600', glow: 'shadow-purple-500/50' },
  { name: 'Lucha', icon: '<circle cx="12" cy="12" r="10"/><line x1="22" x2="18" y1="12" y2="12"/><line x1="6" x2="2" y1="12" y2="12"/><line x1="12" x2="12" y1="6" y2="2"/><line x1="12" x2="12" y1="22" y2="18"/>', color: 'from-orange-500 to-amber-700', glow: 'shadow-orange-500/50' },
  { name: 'Siniestro', icon: '<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>', color: 'from-slate-400 to-zinc-800', glow: 'shadow-zinc-500/50' },
  { name: 'Acero', icon: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2-1 4-2 7-2 2.5 0 4.5 1 6.5 2a1 1 0 0 1 1 1z"/>', color: 'from-slate-200 to-slate-500', glow: 'shadow-slate-300/50' },
  { name: 'Dragón', icon: '<polyline points="14.5 17.5 3 6 3 3 6 3 17.5 14.5"/><line x1="13" x2="19" y1="19" y2="13"/><line x1="16" x2="21" y1="16" y2="21"/><line x1="19" x2="21" y1="21" y2="19"/>', color: 'from-indigo-400 to-blue-800', glow: 'shadow-indigo-500/50' },
  { name: 'Hada', icon: '<path d="M12.67 19a2 2 0 0 0 1.416-.588l6.154-6.172a6 6 0 0 0-8.49-8.49L5.586 9.914A2 2 0 0 0 5 11.328V18a1 1 0 0 0 1 1z"/><polyline points="16 8 2 22"/><polyline points="17.5 15 9 6.5"/>', color: 'from-pink-300 to-rose-500', glow: 'shadow-pink-400/50' },
];
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Copa Artemis 2026</title>
    <!-- Tailwind inyectado para garantizar que los estilos carguen -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-[#08090d] text-slate-100 font-sans antialiased relative overflow-x-hidden selection:bg-slate-300 selection:text-slate-900">
  
  <!-- BACKGROUND GRAPHICS: METALLIC CYBERPUNK GRID & AMBIENT GLOW -->
  <div class="fixed inset-0 pointer-events-none z-0">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(203,213,225,0.12),rgba(255,255,255,0))]"></div>
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#1e293b15_1px,transparent_1px),linear-gradient(to_bottom,#1e293b15_1px,transparent_1px)] bg-[size:32px_32px]"></div>
    <div class="absolute top-1/4 left-10 w-96 h-96 bg-slate-300/5 rounded-full blur-3xl animate-pulse"></div>
    <div class="absolute bottom-1/3 right-10 w-96 h-96 bg-amber-500/5 rounded-full blur-3xl animate-pulse" style="animation-duration: 6s;"></div>
  </div>

  <!-- TOP FLOATING NAVIGATION / UTILITY BAR -->
  <header class="sticky top-0 z-40 backdrop-blur-xl bg-[#08090d]/80 border-b border-slate-800/80 px-4 py-3 shadow-2xl">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">
      
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-slate-200 via-slate-400 to-slate-700 p-[1px] shadow-lg shadow-slate-500/20">
          <div class="w-full h-full bg-[#0d0f17] rounded-[11px] flex items-center justify-center">
            <svg class="w-5 h-5 text-amber-400 animate-bounce" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
          </div>
        </div>
        <div>
          <span class="text-xs font-bold tracking-widest text-slate-400 uppercase block">Torneo Oficial Moemon</span>
          <span class="text-sm font-black tracking-wider text-slate-100 bg-gradient-to-r from-slate-100 via-slate-300 to-slate-400 bg-clip-text text-transparent">
            COPA ARTEMIS 2026
          </span>
        </div>
      </div>

      <!-- Quick Controls -->
      <div class="flex items-center gap-2">
        <button id="btn-leaderboard" class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-800/70 hover:bg-slate-700/80 border border-slate-600/40 text-xs font-semibold text-slate-200 transition-all active:scale-95">
          <svg class="w-4 h-4 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          <span class="hidden sm:inline">Tabla de Jugadores</span>
          <span id="player-count" class="bg-slate-900 text-slate-300 text-[10px] px-1.5 py-0.5 rounded-full border border-slate-700">6</span>
        </button>

        <button id="btn-share" class="p-2 rounded-lg bg-slate-800/70 hover:bg-slate-700/80 border border-slate-600/40 text-slate-300 transition-all hover:text-slate-100" title="Compartir evento">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" x2="15.42" y1="13.51" y2="17.49"/><line x1="15.41" x2="8.59" y1="6.51" y2="10.49"/></svg>
        </button>

        <button id="btn-audio" class="p-2 rounded-lg bg-slate-800/70 hover:bg-slate-700/80 border border-slate-600/40 text-slate-300 transition-all hover:text-slate-100" title="Silenciar">
          <svg id="icon-vol-on" class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/></svg>
          <svg id="icon-vol-off" class="w-4 h-4 text-rose-400 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="23" x2="1" y1="1" y2="23"/><line x1="22.54" x2="16.46" y1="8.46" y2="14.54"/></svg>
        </button>
      </div>

    </div>
  </header>

  <!-- TOAST NOTIFICATION -->
  <div id="toast-container" class="fixed top-16 right-4 z-50 animate-in fade-in slide-in-from-top-4 duration-300 hidden pointer-events-none">
    <div id="toast-body" class="px-4 py-3 rounded-xl border backdrop-blur-md shadow-2xl flex items-center gap-3 bg-slate-900/90 border-slate-500/50 text-slate-100">
      <svg class="w-5 h-5 shrink-0 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
      <p id="toast-text" class="text-sm font-medium">Notificación</p>
    </div>
  </div>

  <main class="relative z-10 max-w-6xl mx-auto px-2 sm:px-4 py-6 md:py-10">
    <div class="relative rounded-2xl md:rounded-3xl p-[2px] md:p-[3px] bg-gradient-to-b from-slate-200 via-slate-400 to-slate-700 shadow-[0_0_50px_rgba(203,213,225,0.18)]">
      
      <div class="bg-[#0b0c12] rounded-[14px] md:rounded-[22px] overflow-hidden relative">

        <!-- SIDE RAIL TYPE BADGES -->
        <div class="hidden lg:flex flex-col gap-3 absolute left-3 top-1/2 -translate-y-1/2 z-20 pointer-events-auto">
          {POKEMON_TYPES.slice(0, 5).map((type) => (
            <div class={`w-9 h-9 rounded-xl bg-slate-900/90 border border-slate-700 flex items-center justify-center group hover:scale-110 transition-all duration-300 shadow-md ${type.glow}`} title={type.name}>
              <svg class="w-4 h-4 text-slate-300 group-hover:text-amber-400 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={type.icon} />
            </div>
          ))}
        </div>

        <div class="hidden lg:flex flex-col gap-3 absolute right-3 top-1/2 -translate-y-1/2 z-20 pointer-events-auto">
          {POKEMON_TYPES.slice(5, 10).map((type) => (
            <div class={`w-9 h-9 rounded-xl bg-slate-900/90 border border-slate-700 flex items-center justify-center group hover:scale-110 transition-all duration-300 shadow-md ${type.glow}`} title={type.name}>
              <svg class="w-4 h-4 text-slate-300 group-hover:text-amber-400 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={type.icon} />
            </div>
          ))}
        </div>

        <!-- CONTENT -->
        <div class="p-4 sm:p-8 md:p-12 lg:px-16">
          <div class="text-center mb-6">
            <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-slate-800/80 border border-amber-500/40 shadow-inner">
              <svg class="w-4 h-4 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m2 4 3 12h14l3-12-6 7-4-7-4 7-6-7zm3 16h14"/></svg>
              <h2 class="text-xs sm:text-sm font-bold tracking-[0.25em] text-amber-300 uppercase">
                COPA ARTEMIS
              </h2>
            </div>
          </div>

          <div class="text-center space-y-2 mb-8">
            <h1 class="text-2xl sm:text-4xl md:text-5xl font-black tracking-tight text-slate-100 uppercase font-sans drop-shadow-md">
              CONCURSO ARTEMIS
            </h1>
            <div class="text-xl sm:text-3xl md:text-4xl font-extrabold tracking-wide text-transparent bg-clip-text bg-gradient-to-r from-slate-200 via-slate-100 to-slate-400">
              x CURI GAMEPLAYS
            </div>
            <div class="pt-2">
              <p class="text-xs sm:text-sm md:text-base font-bold tracking-widest text-amber-400 uppercase">
                ATRAPALOS A TODOS - CACERÍA DE POKEMON EN MOEMON KETZAL
              </p>
            </div>
          </div>

          <div class="max-w-2xl mx-auto text-center mb-10">
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed font-normal">
              Participa en el primer gran torneo de captura de Pokémon Moemon. Una carrera épica para ver quién es el maestro absoluto. El primero en completar la Pokédex será el ganador y se llevará la gloria y un premio masivo.
            </p>
          </div>

          <!-- TIMER -->
          <div class="mb-10 max-w-2xl mx-auto rounded-xl bg-gradient-to-r from-slate-900 via-slate-800/90 to-slate-900 p-4 border border-slate-700/60 shadow-xl">
            <div class="flex items-center justify-between mb-3 border-b border-slate-700/50 pb-2">
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-amber-400 animate-spin" style="animation-duration: 10s;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                <span class="text-xs font-bold tracking-wider text-slate-300 uppercase">INICIO DEL TORNEO EN VIVO</span>
              </div>
              <span class="text-[11px] font-mono text-emerald-400 bg-emerald-950/60 px-2 py-0.5 rounded border border-emerald-800/50">
                10 OCT, 2026
              </span>
            </div>

            <div class="grid grid-cols-4 gap-2 text-center">
              <div class="bg-slate-950/70 p-2 rounded-lg border border-slate-800">
                <div id="t-days" class="text-lg sm:text-2xl font-black font-mono text-slate-100">00</div>
                <div class="text-[10px] text-slate-400 uppercase font-bold">Días</div>
              </div>
              <div class="bg-slate-950/70 p-2 rounded-lg border border-slate-800">
                <div id="t-hours" class="text-lg sm:text-2xl font-black font-mono text-slate-100">00</div>
                <div class="text-[10px] text-slate-400 uppercase font-bold">Horas</div>
              </div>
              <div class="bg-slate-950/70 p-2 rounded-lg border border-slate-800">
                <div id="t-minutes" class="text-lg sm:text-2xl font-black font-mono text-slate-100">00</div>
                <div class="text-[10px] text-slate-400 uppercase font-bold">Min</div>
              </div>
              <div class="bg-slate-950/70 p-2 rounded-lg border border-slate-800">
                <div id="t-seconds" class="text-lg sm:text-2xl font-black font-mono text-slate-100">00</div>
                <div class="text-[10px] text-slate-400 uppercase font-bold">Seg</div>
              </div>
            </div>
          </div>

          <!-- CARDS -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
            <div class="group relative rounded-xl bg-slate-900/90 p-4 border border-slate-700 hover:border-slate-400 transition-all duration-300 shadow-lg flex flex-col items-center text-center justify-center">
              <div class="w-12 h-12 rounded-full bg-slate-800 flex items-center justify-center mb-2 border border-slate-600 group-hover:scale-110 transition-transform">
                <svg class="w-6 h-6 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
              </div>
              <span class="text-[10px] font-bold text-slate-400 tracking-widest uppercase">PREMIO MAYOR</span>
              <p class="text-sm sm:text-base font-extrabold text-rose-500 tracking-wider uppercase mt-1">REGALOS EXCLUSIVOS</p>
            </div>
            <div class="group relative rounded-xl bg-slate-900/90 p-4 border border-slate-700 hover:border-slate-400 transition-all duration-300 shadow-lg flex flex-col items-center text-center justify-center">
              <div class="flex items-center gap-2 mb-2">
                <span class="px-3 py-1 bg-amber-500/20 text-amber-300 border border-amber-500/40 rounded-md text-xs font-bold tracking-wider uppercase">MOÉMON KETZAL</span>
              </div>
              <p class="text-xs sm:text-sm font-extrabold text-slate-100 tracking-wider uppercase">ÚNICO JUEGO OFICIAL</p>
            </div>
            <div class="group relative rounded-xl bg-slate-900/90 p-4 border border-slate-700 hover:border-slate-400 transition-all duration-300 shadow-lg flex flex-col items-center text-center justify-center">
              <div class="w-10 h-10 rounded-full border-2 border-amber-400/80 bg-slate-950 flex flex-col items-center justify-center mb-1">
                <span class="text-[9px] font-bold text-amber-400 leading-none">1</span>
                <span class="text-[8px] text-slate-300 font-extrabold leading-none">Master</span>
              </div>
              <p class="text-xs sm:text-sm font-extrabold text-slate-100 tracking-wider uppercase">1 GANADOR ABSOLUTO</p>
              <span class="text-[10px] text-slate-400 font-medium">POKÉDEX COMPLETADA</span>
            </div>
          </div>

          <!-- BUTTONS -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-xl mx-auto mb-10">
            <button id="btn-open-register" class="group relative overflow-hidden rounded-xl p-[2px] bg-gradient-to-r from-slate-200 via-slate-100 to-slate-400 shadow-xl hover:shadow-slate-300/20 active:scale-98 transition-all">
              <div class="bg-slate-950 rounded-[10px] px-6 py-4 flex flex-col items-center justify-center group-hover:bg-slate-900/90 transition-colors">
                <span class="text-base font-black tracking-wider text-slate-100 uppercase flex items-center gap-2">
                  ¡INSCRÍBETE AHORA!
                  <svg class="w-4 h-4 text-amber-400 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
                </span>
                <span class="text-[11px] text-slate-400 font-medium">(Cupos Limitados)</span>
              </div>
            </button>
            <button id="btn-open-rules" class="group relative overflow-hidden rounded-xl border border-slate-700 bg-slate-900/80 hover:border-slate-400 p-4 flex flex-col items-center justify-center active:scale-98 transition-all shadow-lg">
              <span class="text-base font-black tracking-wider text-slate-100 uppercase flex items-center gap-2">
                REGLAMENTO OFICIAL
                <svg class="w-4 h-4 text-slate-400 group-hover:text-amber-400 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" x2="8" y1="13" y2="13"/><line x1="16" x2="8" y1="17" y2="17"/><line x1="10" x2="8" y1="9" y2="9"/></svg>
              </span>
              <span class="text-[11px] text-slate-400 font-medium">(Ver. Ketzal Ver.)</span>
            </button>
          </div>

          <!-- DETALLES Y FOOTER -->
          <div class="text-center mb-6">
            <span class="inline-block px-6 py-1.5 rounded-full border border-amber-500/30 bg-slate-900/90 text-xs font-extrabold tracking-widest text-amber-400 uppercase shadow-md">
              DETALLES DEL CONCURSO
            </span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
            <div class="rounded-2xl bg-slate-900/80 border border-slate-800 p-6 flex flex-col justify-between shadow-xl">
              <div class="space-y-6">
                <div>
                  <div class="flex items-center gap-2 text-amber-400 mb-1">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                    <span class="text-xs font-black tracking-wider uppercase">FECHA:</span>
                  </div>
                  <p class="text-lg font-black text-slate-100 tracking-wide">10-25 DE OCTUBRE, 2026</p>
                  <p class="text-xs text-slate-400 mt-0.5">Horario: 16:00 GMT-6 · 15 días de competición</p>
                </div>
                <div>
                  <div class="flex items-center gap-2 text-amber-400 mb-1">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                    <span class="text-xs font-black tracking-wider uppercase">LUGAR:</span>
                  </div>
                  <p class="text-sm font-extrabold text-slate-100 uppercase tracking-wide">SERVIDOR EXCLUSIVO MOEMON KETZAL</p>
                  <p class="text-xs text-slate-400 mt-0.5">Emisiones en vivo por Curi Gameplays y YouTube Gaming</p>
                </div>
              </div>
              <div class="mt-8 pt-4 border-t border-slate-800 flex items-center justify-between">
                <span class="text-xs font-extrabold tracking-wider text-amber-400 uppercase">MOÉMON <span class="text-slate-100">KETZAL</span></span>
                <div class="flex items-center gap-2">
                  <span class="text-base" title="Planta">🌱</span><span class="text-base" title="Fuego">🔥</span><span class="text-base" title="Agua">💧</span>
                </div>
              </div>
            </div>

            <div class="rounded-2xl bg-slate-900/80 border border-slate-800 p-6 flex flex-col justify-between shadow-xl">
              <div class="space-y-4">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2 text-amber-400">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
                    <span class="text-xs font-black tracking-wider uppercase">INSCRIPCIONES:</span>
                  </div>
                  <span class="px-2.5 py-0.5 rounded text-[11px] font-black uppercase tracking-wider bg-rose-500/20 text-rose-400 border border-rose-500/40">ABIERTAS</span>
                </div>
                <div class="text-xs text-slate-300 space-y-1 font-medium">
                  <p class="font-bold text-slate-200">REGISTRO INDIVIDUAL ACTIVO</p>
                  <p>• Carrera individual de velocidad</p>
                  <p>• Región Ketzal (completa)</p>
                  <p>• Pokédex Galar Ampliada</p>
                </div>
                <div class="pt-2 border-t border-slate-800/80">
                  <p class="text-xs text-slate-300"><strong class="text-amber-400 font-bold">🏆 Premios:</strong> Master Trophy + <span class="text-rose-400 font-bold">REGALOS EXCLUSIVOS</span></p>
                </div>
              </div>
              <div class="mt-6">
                <a href="#" class="w-full py-3.5 px-4 rounded-xl bg-gradient-to-r from-slate-700 via-slate-800 to-slate-900 border border-slate-500/50 flex items-center justify-center gap-3 text-slate-100 text-xs font-black tracking-wider uppercase transition-all shadow-lg hover:shadow-slate-500/20">
                  UNIRSE AL CANAL DE CURI GAMEPLAYS
                </a>
              </div>
            </div>
          </div>
          
        </div>
      </div>
    </div>
  </main>

  <!-- MODAL: REGISTRO -->
  <div id="modal-register" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/80 backdrop-blur-md animate-in fade-in duration-200">
    <div class="relative w-full max-w-lg rounded-2xl bg-slate-900 border border-slate-600 shadow-2xl p-6 overflow-hidden">
      <button class="close-modal absolute top-4 right-4 text-slate-400 hover:text-slate-100 p-1 rounded-lg bg-slate-800 border border-slate-700">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" x2="6" y1="6" y2="18"/><line x1="6" x2="18" y1="6" y2="18"/></svg>
      </button>
      <div class="flex items-center gap-3 mb-6 border-b border-slate-800 pb-4">
        <div class="p-2.5 rounded-xl bg-slate-800 border border-slate-700 text-amber-400">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" x2="19" y1="8" y2="14"/><line x1="22" x2="16" y1="11" y2="11"/></svg>
        </div>
        <div>
          <h3 class="text-lg font-black text-slate-100 uppercase tracking-wide">Registro de Entrenador</h3>
          <p class="text-xs text-slate-400">Inscripción para la Copa Artemis Moémon</p>
        </div>
      </div>
      <form id="form-register" class="space-y-4">
        <div>
          <label class="block text-xs font-bold text-slate-300 uppercase mb-1">Nombre de Entrenador *</label>
          <input type="text" id="reg-nick" required class="w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-slate-100 focus:outline-none focus:border-slate-400 transition-colors" />
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-300 uppercase mb-1">Usuario de Discord *</label>
          <input type="text" id="reg-discord" required class="w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-slate-100 focus:outline-none focus:border-slate-400 transition-colors" />
        </div>
        <div class="pt-2">
          <label class="flex items-start gap-2.5 cursor-pointer">
            <input type="checkbox" id="reg-rules" class="mt-0.5 rounded border-slate-700 bg-slate-950 text-amber-500" />
            <span class="text-xs text-slate-400 leading-snug">Acepto cumplir con el reglamento oficial y juego limpio.</span>
          </label>
        </div>
        <div class="pt-4 flex justify-end gap-3">
          <button type="button" class="close-modal px-4 py-2 rounded-xl bg-slate-800 text-slate-300 text-xs font-bold hover:bg-slate-700 transition-colors">Cancelar</button>
          <button type="submit" class="px-6 py-2.5 rounded-xl bg-gradient-to-r from-slate-200 via-slate-100 to-slate-400 text-slate-950 text-xs font-black uppercase tracking-wider hover:opacity-90 transition-opacity shadow-lg">Confirmar Inscripción</button>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL: REGLAS -->
  <div id="modal-rules" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/80 backdrop-blur-md animate-in fade-in duration-200">
    <div class="relative w-full max-w-2xl rounded-2xl bg-slate-900 border border-slate-600 shadow-2xl p-6 overflow-hidden max-h-[85vh] flex flex-col">
      <button class="close-modal absolute top-4 right-4 text-slate-400 hover:text-slate-100 p-1 rounded-lg bg-slate-800 border border-slate-700">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" x2="6" y1="6" y2="18"/><line x1="6" x2="18" y1="6" y2="18"/></svg>
      </button>
      <div class="flex items-center gap-3 mb-4 border-b border-slate-800 pb-4 shrink-0">
        <div class="p-2.5 rounded-xl bg-slate-800 border border-slate-700 text-amber-400">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2-1 4-2 7-2 2.5 0 4.5 1 6.5 2a1 1 0 0 1 1 1z"/></svg>
        </div>
        <div>
          <h3 class="text-lg font-black text-slate-100 uppercase tracking-wide">Reglamento Oficial</h3>
        </div>
      </div>
      <div class="overflow-y-auto space-y-4 pr-2 text-xs text-slate-300 leading-relaxed scrollbar-thin scrollbar-thumb-slate-700">
        <div class="bg-slate-950 p-3.5 rounded-xl border border-slate-800">
          <h4 class="font-bold text-amber-400 uppercase text-xs mb-1">1. Formato de Competición</h4>
          <p>Carrera individual de velocidad para completar el 100% de la Pokédex en la RomHack Moémon Ketzal oficial.</p>
        </div>
      </div>
      <div class="pt-4 mt-4 border-t border-slate-800 flex justify-end shrink-0">
        <button class="close-modal px-6 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-bold transition-colors">Cerrar</button>
      </div>
    </div>
  </div>

  <!-- MODAL: LEADERBOARD -->
  <div id="modal-leaderboard" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/80 backdrop-blur-md animate-in fade-in duration-200">
    <div class="relative w-full max-w-3xl rounded-2xl bg-slate-900 border border-slate-600 shadow-2xl p-6 overflow-hidden max-h-[85vh] flex flex-col">
      <button class="close-modal absolute top-4 right-4 text-slate-400 hover:text-slate-100 p-1 rounded-lg bg-slate-800 border border-slate-700">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" x2="6" y1="6" y2="18"/><line x1="6" x2="18" y1="6" y2="18"/></svg>
      </button>
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 border-b border-slate-800 pb-4 shrink-0">
        <div class="flex items-center gap-3">
          <div class="p-2.5 rounded-xl bg-slate-800 border border-slate-700 text-amber-400">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
          </div>
          <div>
            <h3 class="text-lg font-black text-slate-100 uppercase tracking-wide">Entrenadores</h3>
          </div>
        </div>
        <div class="relative">
          <svg class="w-4 h-4 text-slate-500 absolute left-3 top-1/2 -translate-y-1/2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" x2="16.65" y1="21" y2="16.65"/></svg>
          <input type="text" id="search-trainer" placeholder="Buscar entrenador..." class="bg-slate-950 border border-slate-700 rounded-xl pl-9 pr-4 py-1.5 text-xs text-slate-200 focus:outline-none focus:border-slate-500 w-full sm:w-48" />
        </div>
      </div>
      <div id="trainer-list" class="overflow-y-auto space-y-2 pr-1 scrollbar-thin scrollbar-thumb-slate-700">
        <!-- Renderizado dinámico desde JS -->
      </div>
    </div>
  </div>

  <script>
    // ESTADO
    let isAudioMuted = false;
    let trainers = [
      { rank: 1, name: "KetzalMaster99", pokedex: "184/200", status: "En Carrera", region: "Ketzal Alpha", avatar: "👑" },
      { rank: 2, name: "CuriFanatic_Rx", pokedex: "162/200", status: "En Carrera", region: "Ketzal Beta", avatar: "⚡" },
      { rank: 3, name: "ArtemisChallenger", pokedex: "145/200", status: "En Carrera", region: "Ketzal Alpha", avatar: "🔥" },
    ];

    // AUDIO
    const playAudioFx = (type = 'click') => {
      if (isAudioMuted) return;
      try {
        const AudioCtx = window.AudioContext || window.webkitAudioContext;
        if (!AudioCtx) return;
        const ctx = new AudioCtx();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.connect(gain); gain.connect(ctx.destination);
        const now = ctx.currentTime;
        if (type === 'click') {
          osc.type = 'sine'; osc.frequency.setValueAtTime(800, now); osc.frequency.exponentialRampToValueAtTime(400, now + 0.08);
          gain.gain.setValueAtTime(0.15, now); gain.gain.exponentialRampToValueAtTime(0.01, now + 0.08);
          osc.start(now); osc.stop(now + 0.08);
        } else if (type === 'modal') {
          osc.type = 'triangle'; osc.frequency.setValueAtTime(300, now); osc.frequency.exponentialRampToValueAtTime(900, now + 0.15);
          gain.gain.setValueAtTime(0.1, now); gain.gain.exponentialRampToValueAtTime(0.01, now + 0.15);
          osc.start(now); osc.stop(now + 0.15);
        } else if (type === 'success') {
          [523.25, 659.25, 783.99].forEach((freq, idx) => {
            const o = ctx.createOscillator(), g = ctx.createGain(); o.type = 'triangle';
            o.frequency.setValueAtTime(freq, now + idx * 0.05); g.gain.setValueAtTime(0.12, now + idx * 0.05);
            g.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.05 + 0.3);
            o.connect(g); g.connect(ctx.destination); o.start(now + idx * 0.05); o.stop(now + idx * 0.05 + 0.3);
          });
        }
      } catch(e) {}
    };

    // DOM EVENT LISTENERS
    document.addEventListener('DOMContentLoaded', () => {
      document.getElementById('btn-audio').addEventListener('click', () => {
        isAudioMuted = !isAudioMuted;
        document.getElementById('icon-vol-on').classList.toggle('hidden', isAudioMuted);
        document.getElementById('icon-vol-off').classList.toggle('hidden', !isAudioMuted);
      });

      const triggerToast = (msg, type = 'info') => {
        const toast = document.getElementById('toast-container');
        document.getElementById('toast-text').innerText = msg;
        toast.classList.remove('hidden');
        setTimeout(() => toast.classList.add('hidden'), 4000);
      };

      document.getElementById('btn-share').addEventListener('click', () => {
        playAudioFx('click'); navigator.clipboard.writeText(window.location.href); triggerToast('¡Enlace copiado!', 'success');
      });

      const openModal = (id) => { playAudioFx('modal'); document.getElementById(id).classList.remove('hidden'); document.getElementById(id).classList.add('flex'); };
      const closeModals = () => document.querySelectorAll('.fixed.z-50').forEach(el => { if(el.id !== 'toast-container') { el.classList.add('hidden'); el.classList.remove('flex'); }});

      document.getElementById('btn-open-register').addEventListener('click', () => openModal('modal-register'));
      document.getElementById('btn-open-rules').addEventListener('click', () => openModal('modal-rules'));
      document.getElementById('btn-leaderboard').addEventListener('click', () => { openModal('modal-leaderboard'); renderLeaderboard(); });
      document.querySelectorAll('.close-modal').forEach(btn => btn.addEventListener('click', closeModals));

      document.getElementById('form-register').addEventListener('submit', (e) => {
        e.preventDefault();
        const nick = document.getElementById('reg-nick').value;
        const rules = document.getElementById('reg-rules').checked;
        if(!rules) return triggerToast('Debes aceptar el reglamento.', 'error');
        trainers.unshift({ rank: trainers.length + 1, name: nick, pokedex: "0/200", status: "Inscrito", region: "Ketzal", avatar: "✨" });
        document.getElementById('player-count').innerText = trainers.length;
        closeModals(); playAudioFx('success'); triggerToast(`¡Inscripción exitosa, ${nick}!`, 'success'); e.target.reset();
      });

      const renderLeaderboard = (filter = "") => {
        const container = document.getElementById('trainer-list');
        const filtered = trainers.filter(t => t.name.toLowerCase().includes(filter.toLowerCase()));
        container.innerHTML = filtered.map(t => `
          <div class="flex items-center justify-between p-3 rounded-xl bg-slate-950 border border-slate-800">
            <div class="flex items-center gap-3">
              <span class="w-6 text-center text-xs font-mono font-bold text-amber-400">#${t.rank}</span><span class="text-base">${t.avatar}</span>
              <div><p class="text-xs font-bold text-slate-200">${t.name}</p><p class="text-[10px] text-slate-500">${t.region}</p></div>
            </div>
            <div class="flex items-center gap-4 text-right">
              <div><span class="text-xs font-mono font-bold text-emerald-400 block">${t.pokedex}</span><span class="text-[9px] text-slate-500">Pokédex</span></div>
            </div>
          </div>`).join('');
      };
      document.getElementById('search-trainer').addEventListener('input', (e) => renderLeaderboard(e.target.value));

      const targetDate = new Date('2026-10-10T16:00:00-06:00').getTime();
      setInterval(() => {
        const distance = targetDate - new Date().getTime();
        if (distance > 0) {
          document.getElementById('t-days').innerText = Math.floor(distance / (1000 * 60 * 60 * 24));
          document.getElementById('t-hours').innerText = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
          document.getElementById('t-minutes').innerText = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
          document.getElementById('t-seconds').innerText = Math.floor((distance % (1000 * 60)) / 1000);
        }
      }, 1000);
    });
  </script>
</body>
