              >
                <svg width="20" height="20" viewBox="0 0 127.14 96.36" fill="currentColor">
                    <path d="M107.7,8.07A105.15,105.15,0,0,0,81.47,0a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,6.83,72.37,72.37,0,0,0,45.64,0,105.89,105.89,0,0,0,19.39,8.09C2.79,32.65-1.71,56.6.54,80.21h0A105.73,105.73,0,0,0,32.71,96.36,77.7,77.7,0,0,0,39.6,85.25a68.42,68.42,0,0,1-10.85-5.18c.91-.66,1.8-1.34,2.66-2a75.57,75.57,0,0,0,64.32,0c.87.71,1.76,1.39,2.66,2a68.68,68.68,0,0,1-10.87,5.19,77,77,0,0,0,6.89,11.1,105.25,105.25,0,0,0,32.19-16.14c2.64-27.38-4.51-51.11-18.91-72.15ZM42.45,65.69C36.18,65.69,31,60,31,53s5-12.74,11.43-12.74S54,45.91,53.87,53,48.8,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.25,60,73.25,53s5-12.74,11.44-12.74S96.23,45.91,96.11,53,91.08,65.69,84.69,65.69Z"/>
                </svg>
                UNIRSE AL CANAL DE CURI
              </button>
            </div>
          </div>
        </section>

        <footer style={styles.footer}>
          ©2026 CONCURSO ARTEMIS x CURI GAMEPLAYS • Todos los derechos reservados<br/>
          <span style={styles.footerLink}>WWW.CACERIA-KETZAL-ESPORTS.COM</span>
        </footer>

        {/* Estilos inyectados para Media Queries y animaciones */}
        <style>
          {`
            @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@600;800&family=Montserrat:wght@400;600;800&display=swap');
            
            .poster-container {
              width: 100%;
              max-width: 480px;
              transition: all 0.3s ease;
            }
            
            .info-grid {
              flex-direction: column;
            }

            /* RESPONSIVIDAD PARA PC (Pantallas grandes) */
            @media (min-width: 1025px) {
              .poster-container {
                max-width: 1200px !important;
                padding: 60px !important;
                border-width: 4px !important;
                border-radius: 30px !important;
              }
              .info-grid {
                flex-direction: row !important;
                gap: 40px !important;
              }
            }

            @keyframes pulseSilver {
              0% { box-shadow: 0 0 15px rgba(192, 192, 192, 0.2); }
              50% { box-shadow: 0 0 25px rgba(220, 220, 220, 0.5); }
              100% { box-shadow: 0 0 15px rgba(192, 192, 192, 0.2); }
            }
          `}
        </style>

        {/* Modal de Registro */}
        {showModal && (
          <div style={styles.modalOverlay} onClick={() => setShowModal(false)}>
            <div style={styles.modalContent} onClick={e => e.stopPropagation()}>
              <h2 style={styles.silverTitleMain}>REGISTRO OFICIAL</h2>
              <form onSubmit={handleRegister} style={styles.form}>
                <input type="text" placeholder="Nickname en el Juego" required style={styles.input} />
                <input type="email" placeholder="Correo Electrónico" required style={styles.input} />
                <input type="text" placeholder="Usuario de Discord" required style={styles.input} />
                
                <button type="submit" style={styles.submitBtn} disabled={isSubmitting}>
                  {isSubmitting ? 'PROCESANDO...' : 'CONFIRMAR INSCRIPCIÓN'}
                </button>
                <button type="button" onClick={() => setShowModal(false)} style={styles.closeBtn}>
                  CANCELAR
                </button>
              </form>
            </div>
          </div>
        )}
      </div>
    </div>
  );
}

