import React, { useState, useEffect } from 'react';

export default function CopaArtemisApp() {
  const [showModal, setShowModal] = useState(false);
  const [isSubmitting, setIsSubmitting] = useState(false);
  
  // Timer State
  const [timeLeft, setTimeLeft] = useState({
    days: 0, hours: 0, minutes: 0, seconds: 0
  });

  // Countdown Logic (Oct 10, 2026)
  useEffect(() => {
    const targetDate = new Date('October 10, 2026 16:00:00 GMT-0600').getTime();

    const updateTimer = () => {
      const now = new Date().getTime();
      const distance = targetDate - now;

      if (distance > 0) {
        setTimeLeft({
          days: Math.floor(distance / (1000 * 60 * 60 * 24)),
          hours: Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60)),
          minutes: Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60)),
          seconds: Math.floor((distance % (1000 * 60)) / 1000)
        });
      }
    };

    const timerId = setInterval(updateTimer, 1000);
    return () => clearInterval(timerId);
  }, []);

  const handleRegister = (e) => {
    e.preventDefault();
    setIsSubmitting(true);
    // Simular envío
    setTimeout(() => {
      setIsSubmitting(false);
      setShowModal(false);
      alert('¡Inscripción enviada con éxito! Revisa tu Discord.');
    }, 1500);
  };

  return (
    <div style={styles.body}>
      <div style={styles.posterContainer} className="poster-container">
        
        {/* Fondo con cuadrícula y brillos plateados */}
        <div style={styles.gridOverlay}></div>
        <div style={{...styles.glowPoint, ...styles.topLeft}}></div>
        <div style={{...styles.glowPoint, ...styles.bottomRight}}></div>

        {/* Encabezado */}
        <header style={styles.header}>
          <h2 style={styles.goldenSubtitle}>COPA ARTEMIS</h2>
          <h1 style={styles.silverTitleMain}>
            CONCURSO ARTEMIS<br/>x CURI GAMEPLAYS
          </h1>
          <h3 style={styles.silverSubtitle}>
            ATRAPALOS A TODOS - CACERÍA DE POKEMON EN MOEMON KETZAL
          </h3>
          <p style={styles.description}>
            Participa en el primer gran torneo de captura de Pokémon Moemon. 
            Una carrera épica para ver quién es el maestro absoluto. El primero en 
            completar la Pokédex será el ganador y se llevará la gloria y un premio masivo.
          </p>
        </header>

        {/* Paneles Centrales */}
        <section style={styles.centerPanels}>
          <div style={styles.panelBox}>
            <span style={styles.goldText}>🏆 PREMIO MAYOR</span>
            <span style={styles.redHighlight}>REGALOS EXCLUSIVOS</span>
          </div>
          
          <div style={styles.panelBox}>
            <span style={styles.badge}>MOÉMON KETZAL</span> 
            <span style={styles.whiteTextHeavy}>ÚNICO JUEGO OFICIAL</span>
          </div>

          <div style={styles.panelBox}>
            <span style={styles.masterBadge}>1<br/>Master</span>
            <div style={styles.panelTextCol}>
              <span style={styles.whiteTextHeavy}>1 GANADOR ABSOLUTO</span>
              <span style={styles.grayTextSmall}>POKÉDEX COMPLETADA</span>
            </div>
          </div>
        </section>

        {/* Botones de Acción */}
        <section style={styles.actionButtonsContainer}>
          <button 
            style={styles.actionButtonMain} 
            onClick={() => setShowModal(true)}
            onMouseOver={(e) => e.currentTarget.style.transform = 'scale(1.05)'}
            onMouseOut={(e) => e.currentTarget.style.transform = 'scale(1)'}
          >
            ¡INSCRÍBETE AHORA!
            <span style={styles.btnSubtext}>(Cupos Limitados)</span>
          </button>
          
          <button style={styles.actionButtonSecondary}>
            REGLAMENTO OFICIAL
            <span style={styles.btnSubtext}>(Ver. Ketzal Ver.)</span>
          </button>
        </section>

        <div style={styles.dividerContainer}>
          <div style={styles.dividerLine}></div>
          <span style={styles.dividerText}>DETALLES DEL CONCURSO</span>
          <div style={styles.dividerLine}></div>
        </div>

        {/* Paneles de Información (Fecha y Registro) */}
        <section style={styles.infoGrid} className="info-grid">
          <div style={styles.infoCard}>
            <h4 style={styles.goldHeader}>📅 FECHA:</h4>
            <p style={styles.whiteTitle}>10-25 DE OCTUBRE, 2026</p>
            <p style={styles.grayTextSmall}>Horario: 16:00 GMT-6 • 15 días de competición</p>
            
            <h4 style={{...styles.goldHeader, marginTop: '20px'}}>📍 LUGAR:</h4>
            <p style={styles.whiteTitleSmall}>SERVIDOR EXCLUSIVO MOEMON KETZAL</p>
            <p style={styles.grayTextSmall}>Emisiones en vivo por Curi Gameplays y YouTube Gaming</p>
            
            {/* Countdown */}
            <div style={styles.countdownBox}>
              <div style={styles.countItem}><span>{timeLeft.days}</span><small>D</small></div>
              <div style={styles.countItem}><span>{timeLeft.hours}</span><small>H</small></div>
              <div style={styles.countItem}><span>{timeLeft.minutes}</span><small>M</small></div>
              <div style={styles.countItem}><span>{timeLeft.seconds}</span><small>S</small></div>
            </div>
          </div>

          <div style={styles.infoCard}>
            <h4 style={styles.goldHeader}>☆ INSCRIPCIONES:</h4>
            <p style={styles.redHighlight}>ABIERTAS</p>
            <p style={styles.whiteTitleSmall}>REGISTRO INDIVIDUAL ACTIVO</p>
            <p style={styles.grayTextSmall}>Carrera individual de velocidad • Región Ketzal (completa) • Pokédex Galar Ampliada</p>
            
            <p style={{...styles.goldHeader, fontSize: '0.85rem', marginTop: '15px'}}>
              🏆 Premios: Master Trophy + REGALOS EXCLUSIVOS
